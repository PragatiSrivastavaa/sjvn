{#
/**
 * @file
 * Theme override to display a view of unformatted rows.
 */
#}
<ul class="announcements-modern-list">
{% for row in rows %}
  {% set node = row.content['#row']._entity %}
  <li>
    <a href="{{ path('entity.node.canonical', {'node': node.id}) }}">
      {{ row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ title }}'] }}
    </a>
  </li>
{% endfor %}
</ul>
<style>
.announcements-modern-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.announcements-modern-list li {
    position: relative;
    padding-left: 30px;
    margin-bottom: 15px;
    border-bottom: 1px solid #eee;
    padding-bottom: 10px;
}

.announcements-modern-list li::before {
    content: "•";
    color: #fdb913;
    font-size: 2em;
    position: absolute;
    left: 0;
    top: -8px;
    line-height: 1;
}

.announcements-modern-list a {
    color: #333 !important;
    text-decoration: none;
    font-weight: 500;
    display: block;
    transition: all 0.3s ease;
}

.announcements-modern-list a:hover {
    color: #0072bc !important;
    padding-left: 5px;
}
</style>