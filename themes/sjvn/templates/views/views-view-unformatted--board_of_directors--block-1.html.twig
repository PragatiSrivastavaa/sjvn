{#
/**
 * @file
 * Theme override to display a view of unformatted rows - Board of Directors Block.
 *
 * Available variables:
 * - title: The title of this group of rows. May be empty.
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: A flag indicating whether default classes should be
 *   used on rows.
 *
 * @see template_preprocess_views_view_unformatted()
 */
#}

<section class="inner-sec board_of_directors board-block-view">
  <div class="container">
    {% if rows %}
      {% for row in rows %}
        <div class="row align-items-stretch mb-3">
          
          {# Director Profile Card #}
          <div class="col-sm-12 col-md-4 mb-3 mb-md-0">
            <div class="profile director" role="article" aria-label="Director profile">
              
              {# Director Photo #}
              <div class="profile-img">
                {% set node = row.content['#row']._entity ?? null %}
                {% if node and node.field_image_of_directors is not empty %}
                  <img src="{{ file_url(node.field_image_of_directors.entity.fileuri) }}" alt="{{ node.title.value }}" class="img-fluid">
                {% else %}
                  <img src="{{ base_path ~ directory }}/images/gallery/no-image.png" alt="No image available" />
                {% endif %}
              </div>
              
              {# Director Name and Designation #}
              <div class="profile-text">
                <h2 class="h5">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}']|striptags|trim }}</h2>
                <p>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_degination }}']|striptags|trim }}</p>
              </div>
              
            </div>
          </div>
          
          {# Director Bio/Content #}
          <div class="col-sm-12 col-md-8">
            <div class="common-text">
              {% set director_bio = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ body }}'] %}
              {% if director_bio %}
                {{ director_bio|raw }}
              {% else %}
                <p>Profile information coming soon.</p>
              {% endif %}
            </div>
          </div>
          
        </div>
        
        {# Add separator between directors except for last one #}
        {% if not loop.last %}
          <hr class="director-separator" aria-hidden="true">
        {% endif %}
        
      {% endfor %}
    {% else %}
      {# Empty state #}
      <div class="view-empty">
        <p>No board members available at this time.</p>
      </div>
    {% endif %}
  </div>
</section>