{#
/**
 * @file
 * Theme override to display a view of unformatted rows - Board of Directors Page.
 *
 * Available variables:
 * - title: The title of this group of rows. May be empty.
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: A flag indicating whether default classes should be
 *   used on rows.
 *
 * @see template_preprocess_views_view_unformatted()
 */
#}

<section class="inner-sec board_of_directors">
  <div class="container">
    
    {# Introduction message for the board #}
    {% for row in rows %}
      {% if loop.first and row.content['#row']._entity.field_directors_category is empty %}
        <div class="row mb-5">
          <div class="col-12">
            <p class="directors-message">
              The business of the Company is managed by a Board of Directors consisting of Whole Time Directors and Part-Time Directors. SJVN is currently headed by a Chairman and Managing Director (CMD) and Three (3) Functional Directors viz. Director (Personnel), Director (Finance) and Director (Projects). In addition, there are Two (2) Part-Time Directors representing the Government of India and Government of Himachal Pradesh. There are also Two Non-Official Part-Time Independent Directors on the Board of the Company.
            </p>
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% set current_category = '' %}
    {% set row_opened = false %}

    {% for row in rows %}
      {% set category = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_directors_category }}'] %}
      {% set node = row.content['#row']._entity %}

      {# Print heading and start a new row when category changes #}
      {% if category != current_category %}
        {% if row_opened %}
          </div> {# Close previous row #}
        {% endif %}
        
        {% if category %}
          <h2 class="subtitle">{{ category }}</h2>
        {% endif %}
        
        <div class="row">
        {% set current_category = category %}
        {% set row_opened = true %}
      {% endif %}

      <div class="col-sm-6 col-md-4 col-lg-3 mb-4">
        <div class="profile" role="article" aria-label="Director profile">
          <div class="profile-img">
            {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_image_of_directors }}'] }}
          </div>
          <div class="profile-text">
            <h5>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h5>
            <p>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_degination }}'] }}</p>
            <a href="{{ path('entity.node.canonical', {'node': node.id}) }}" 
               class="view-profile-btn"
               aria-label="View profile of {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}">
              View Profile
            </a>
          </div>
        </div>
      </div>
      
      {# Close the row if it's the last item #}
      {% if loop.last and row_opened %}
        </div>
      {% endif %}
      
    {% endfor %}

  </div>
</section>

