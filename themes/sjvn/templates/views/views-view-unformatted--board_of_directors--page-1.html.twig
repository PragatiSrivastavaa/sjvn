{#
/**
 * @file
 * Theme override to display a view of unformatted rows.
 *
 * Available variables:
 * - title: The title of this group of rows. May be empty.
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: A flag indicating whether default classes should be
 *   used on rows.
 *
 * @see template_preprocess_views_view_unformatted()
 */
#}
<section class="inner-sec board_of_directors">
  <div class="container">
    {% set current_category = '' %}

    {% for row in rows %}
      {% set category = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_directors_category }}'] %}

      {# Print heading and start a new row when category changes #}
      {% if category != current_category %}
        {% if current_category != '' %}
          </div> {# Close previous row #}
        {% endif %}
        <h2 class="subtitle mt-5">{{ category }}</h2>
        <div class="row">
        {% set current_category = category %}
      {% endif %}

      <div class="col-sm-3 col-lg-3">
        <div class="profile">
          <div class="profile-img">
            {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_image_of_directors }}'] }}
          </div>
          <div class="profile-text">
            <h5>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h5>
            <p>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_degination }}'] }}</p>
            {% set node = row.content['#row']._entity %}

      <a href="{{ path('entity.node.canonical', {'node': node.id}) }}">
        {% if current_language == 'hi' %}
           प्रोफ़ाइल देखें
        {% else %}
         View profile
        {% endif %}
          </a>
          </div>
        </div>
      </div>
      
{% endfor %}

    </div>
  </div>
</section>

