{#
/**
 * @file
 * Custom layout: Horizontal tabs above content.
 */
#}

{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}

<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    <h2 class="portfolio-view-title">{{ title }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% if header %}
    <div class="about-intro-section">
      {{ header }}
    </div>
  {% endif %}

  {# Horizontal tabs at full width #}
  {% if exposed %}
    <div class="mb-4">
      {{ exposed }}
    </div>
  {% endif %}

  {# Content rows at full width #}
  <div class="portfolio-content">
    {% if rows %}
      {{ rows }}
    {% elseif empty %}
      <div class="view-empty">{{ empty }}</div>
    {% endif %}
  </div>

  {% if pager %}
    <div class="mt-3">
      {{ pager }}
    </div>
  {% endif %}
  {% if attachment_after %}
    <div class="attachment attachment-after mt-3">
      {{ attachment_after }}
    </div>
  {% endif %}
  {% if more %}
    <div class="mt-3">
      {{ more }}
    </div>
  {% endif %}
  {% if footer %}
    <div class="view-footer mt-3">
      {{ footer }}
    </div>
  {% endif %}
  {% if feed_icons %}
    <div class="feed-icons mt-3">
      {{ feed_icons }}
    </div>
  {% endif %}
</div>
