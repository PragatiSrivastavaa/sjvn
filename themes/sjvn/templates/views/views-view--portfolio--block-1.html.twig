{#
/**
 * @file
 * Custom layout: Exposed form left, content right using Bootstrap 5.
 */
#}

{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
  {# Bootstrap row for two-column layout #}
  {{ title_prefix }}
  {% if title %}
    <h2 class="portfolio-view-title">{{ title }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% if header %}
      {{ header }}
  {% endif %}

<section class="portfolio-section">
<div class="container text-center">
  
{% if exposed %}

        {{ exposed }}

  {% endif %}

  {% if rows %}
      {{ rows }}
    {% endif %}
    </div>
</section>



