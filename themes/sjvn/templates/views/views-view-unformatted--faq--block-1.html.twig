<section class="about-part" id="about-part">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 col-12">

        <!-- Main Accordion: Sub-Committees of the Board -->
        <div class="accordion" id="boardSubCommitteesAccordion">

          <div class="accordion-item">
            <h2 class="accordion-header" id="headingMain">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMain" aria-expanded="false" aria-controls="collapseMain">
               
                 {% if current_language == 'hi' %}
                  निदेशक मंडल की उप समितियाँ
                  {% else %}
                  Sub-Committees of the Board
                  {% endif %}
              </button>
            </h2>
            <div id="collapseMain" class="accordion-collapse collapse" aria-labelledby="headingMain" data-bs-parent="#boardSubCommitteesAccordion">
              <div class="accordion-body">

                
                 {% if current_language == 'hi' %}
                 <p> निदेशक मंडल की निम्नलिखित उप-समितियां हैं:</p>
                  {% else %}
                 <p>Board of Directors has the following sub-committees. The compositions of the Sub-Committees of the Board are given below:</p>
                  {% endif %}

<div class="accordion" id="accordionFaqBlock1">
  {% for row in rows %}
    
    {% set faq_id = 'faq-block1-' ~ loop.index %}

    <div class="accordion-item">
      <h2 class="accordion-header" id="heading-faq-block1-{{ loop.index }}">
        <button class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#{{ faq_id }}"
                aria-expanded="false"
                aria-controls="{{ faq_id }}">
          {{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ title }}'] }}
        </button>
      </h2>

      <div id="{{ faq_id }}"
           class="accordion-collapse collapse"
           aria-labelledby="heading-faq-block1-{{ loop.index }}"
           data-bs-parent="#accordionFaqBlock1">
        <div class="accordion-body">
          {{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ body }}'] }}
        </div>
      </div>
    </div>
  {% endfor %}
</div>

    </div>
            </div>
          </div> <!-- /Main Accordion Item -->

        </div> <!-- /boardSubCommitteesAccordion -->

      </div>
    </div>
  </div>
</section>