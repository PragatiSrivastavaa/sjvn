<section class="inner-sec key-executive container-fluid empanelled-hospital">
   <div class="row">
      {% for row in rows %}
      {% set node = row.content['#row']._entity %}
      <div class="col-lg-4 col-md-6 mb-4">
         <div class="key-executive hover-afect ">
            <h6>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h6>
            <div class="key-text-box hospital d-flex flex-column">
               <p class="mb-0"><strong>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</strong></p>
               <p class="hospotal-sec"><span>Specialties:</span>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_specialties }}'] }}</p>
               <p class="hospotal-sec"><span>Discount:</span> {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_discount_details }}'] }}</p>
               <p class="hospotal-sec"><span>City:</span> {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_locations }}'] }}</p>
               <p class="hospotal-sec"><span>State:</span>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_district }}'] }}</p>
               <p class="hospotal-sec"><span>Address:</span>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ body }}'] }}</p>
              <div class="d-flex gap-3 mt-auto pt-2 flex-wrap mt-2">
               <p class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-location-dot"></i> {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_google_map }}'] }}</p>
               <p class="btn btn-outline-danger btn-sm">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_related_documents }}'] }}</p>
              </div>
              
            </div>
         </div>
      </div>
      {% endfor %}
   </div>
</section>
<style>
   .flex-wrap .btn a:hover{
      color: white !important;
   }
   p.hospotal-sec {
       margin-bottom: 6px;
    padding-bottom: 6px;
    font-size: 14px;
    border-bottom: 1px solid #e3e3e3;
}
   p.hospotal-sec span {
    font-weight: 500;
    color: #313131;
}
   .empanelled-hospital .key-executive {
    background: #ffffff;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #d7ecf5;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.10);
    transition: all 0.4s ease;
    height: 100%;
}
.empanelled-hospital .key-executive h6 {
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(135deg, #009edb, #007cb1);
    border-radius: 4px 4px 0 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    margin-bottom: 0px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.empanelled-hospital .key-text-box p:first-of-type strong {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--second-primary-color);
    line-height: 1.4;
    display: block;
    margin-bottom: 8px;
}
.empanelled-hospital .key-text-box {
    padding: 20px;
    display: flex;
    flex-direction: column;
    height: 87%;
    flex-grow: 1;
    justify-content: space-between;
}
@media (min-width: 1200px) {
   .empanelled-hospital .key-executive h6 {
        font-size: 0.9rem;
        min-height: 60px;
        padding: 13px 15px;
    }
        .empanelled-hospital .key-text-box p:first-of-type strong {
        font-size: 1.2rem;
    }
}
</style>