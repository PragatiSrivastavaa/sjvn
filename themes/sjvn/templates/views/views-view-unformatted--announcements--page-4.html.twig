{#
/**
 * @file
 * Theme override to display a view of unformatted rows.
 */
#}
<ul class="announcements-modern-list">
{% for row in rows %}
  <li>
      {# Render the content (likely the title or body) #}
      {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}
  </li>
{% endfor %}
</ul>

<style>
/* Reusing the effective modern list style */
.announcements-modern-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.announcements-modern-list li {
    position: relative;
    padding-left: 30px;
    margin-bottom: 15px;
    border-bottom: 1px solid #eee;
    padding-bottom: 10px;
    font-size: 1.1rem; /* Slightly larger for readability */
    color: #333;
}

.announcements-modern-list li::before {
    content: "•";
    color: #fdb913; /* SJVN Gold/Yellow */
    font-size: 2em;
    position: absolute;
    left: 0;
    top: -8px;
    line-height: 1;
}

/* Ensure links within the content are styled if present */
.announcements-modern-list li a {
    color: #0072bc; /* SJVN Blue */
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
}

.announcements-modern-list li a:hover {
    text-decoration: underline;
    color: #005a9c;
}

/* Remove border from the last item */
.announcements-modern-list li:last-child {
    border-bottom: none;
    margin-bottom: 0;
}
</style>