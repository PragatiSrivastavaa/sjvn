{#
/**
 * @file
 * Theme override for Subsidiaries view unformatted rows.
 */
#}
{% set subs_items = [] %}
{% set jv_items = [] %}

{% for row in rows %}
  {# Get the parent ID directly from the entity for maximum reliability #}
  {% set term = view.result[loop.index0]._entity %}
  {% set parent_id = 0 %}
  {% if term %}
    {% set parent_id = term.parent.target_id %}
  {% endif %}
  
  {# If for some reason that failed, try the field approach #}
  {% if parent_id == 0 or parent_id is empty %}
    {% set parent_id = view.style_plugin.getField(loop.index0, 'parent_tid')|striptags|trim %}
  {% endif %}
  
  {# 379 is Subsidiaries, 380 is JVs #}
  {% if parent_id == '413' %}
    {% set jv_items = jv_items|merge([{row: row, term: term}]) %}
  {% elseif parent_id == '412' %}
    {% set subs_items = subs_items|merge([{row: row, term: term}]) %}
  {% else %}
    {# Final fallback: check by name if it's CPTC #}
    {% set term_name = view.style_plugin.getField(loop.index0, 'name')|striptags|trim %}
    {% if term_name == 'CPTC' %}
       {% set jv_items = jv_items|merge([{row: row, term: term}]) %}
    {% else %}
       {% set subs_items = subs_items|merge([{row: row, term: term}]) %}
    {% endif %}
  {% endif %}
{% endfor %}

<section class="Subsidiaries">
    <div class="container">
        <!-- SUBSIDIARIES -->
        {% if subs_items|length > 0 %}
            <h2 class="section-title">
                
                 {% if current_language == 'hi' %}
                 अधीनस्‍थ कंपनियां
                  {% else %}
                  Subsidiaries
                  {% endif %}
            </h2>
            <div class="row g-4">
                {% for item in subs_items %}
                    <div class="col-lg-3 col-md-6">
                        <div class="custom-card">
                            {{ item.row.content }}
                            {% if item.term %}
                              <a href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': item.term.id}) }}" aria-label="View details of {{ item.term.label }}">
                                <span class="icon-btn"> <i class="fa-solid fa-angle-right" aria-hidden="true"></i> </span>
                              </a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <!-- JOINT VENTURES -->
        {% if jv_items|length > 0 %}
            <h2 class="section-title mt-5">
               
                 {% if current_language == 'hi' %}
                  संयुक्‍त उपक्रम

                  {% else %}
                   Joint Ventures
                  {% endif %}
            </h2>
            <div class="row justify-content-center g-4">
                {% for item in jv_items %}
                    <div class="col-lg-6 col-md-10">
                        <div class="custom-card">
                            {{ item.row.content }}
                            {% if item.term %}
                              <a href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': item.term.id}) }}" aria-label="View details of {{ item.term.label }}">
                                <span class="icon-btn"> <i class="fa-solid fa-angle-right" aria-hidden="true"></i> </span>
                              </a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
