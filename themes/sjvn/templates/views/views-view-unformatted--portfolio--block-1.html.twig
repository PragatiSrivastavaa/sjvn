{#
/**
 * @file
 * Theme override to display a view of unformatted rows.
 *
 * Available variables:
 * - title: The title of this group of rows. May be empty.
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: A flag indicating whether default classes should be
 *   used on rows.
 *
 * @see template_preprocess_views_view_unformatted()
 */
#}
<div class="container">
  <div class="row">
 {% for row in rows %}
      {% set node = row.content['#row']._entity %}
            <div class="col-sm-6 col-md-6 col-lg-4 col-xl-3">
              <div class="project-card rounded position-relative">
                
                <a href="{{ path('entity.node.canonical', {'node': node.id}) }}" class="project-card-link" aria-label="View Project details: {{ node.label }}">
                 {% if row.content['#row']._entity.field_business_image is not empty %}
                  {{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ field_business_image }}'] }}
                 {% else %}
                  {% set clean_base = request.basePath|replace({'/en': ''}) %}
                  <img src="{{ request.schemeAndHttpHost ~ clean_base ~ '/sjvn/themes/sjvn/images/gallery/no-img-found.png' }}" alt="No Image Available" class="img-fluid project-img">
                 {% endif %}
                </a>

                <div class="d-flex justify-content-between align-items-center mt-3">
                  <h2 class="project-title pt-1 mb-0 h5">
                    <a href="{{ path('entity.node.canonical', {'node': node.id}) }}" class="text-decoration-none">
                      {{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ title }}'] }}
                    </a>
                  </h2>
                  <a href="{{ path('entity.node.canonical', {'node': node.id}) }}" aria-label="View details of {{ node.label }}">
                    <span class="icon-btn"> <i class="fa-solid fa-angle-right" aria-hidden="true"></i> </span>
                  </a>
                </div>
               
              </div>
        </div>
        {% endfor %}
     </div>
     </div>
