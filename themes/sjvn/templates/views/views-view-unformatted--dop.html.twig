<h2 class="subtitle mt-2"> {% if current_language == 'hi' %}
                  शक्तियों का प्रत्यायोजन
                  {% else %}
                  Delegation of Powers
                  {% endif %}</h2>

<div class="accordion" id="accordionFaqPage2">

  {% for row in rows %}
    
    {% set faq_id = 'faq-p2-' ~ loop.index %}

    <div class="accordion-item">
      <h2 class="accordion-header" id="heading-faq-p2-{{ loop.index }}">
        <button class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#{{ faq_id }}"
                aria-expanded="false"
                aria-controls="{{ faq_id }}">
          {{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ title }}'] }}
        </button>
      </h2>

      <div id="{{ faq_id }}"
           class="accordion-collapse collapse"
           aria-labelledby="heading-faq-p2-{{ loop.index }}"
           data-bs-parent="#accordionFaqPage2">
        <div class="accordion-body dopfixheight">
          {{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ body }}'] }}
        </div>
      </div>
    </div>
  {% endfor %}
</div>
