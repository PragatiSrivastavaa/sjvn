{#
/**
 * @file
 * Theme override to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see template_preprocess_region()
 */
#}

	<!-- Top Utility Bar -->
<div class="top-bar">
  <!-- Left Section -->
  <div class="left-links">
  {{ page.header }}
  </div>
  <!-- Center Logos -->
  <div class="middle-logs">
  {{ page.center_logos}}
  </div>

  <!-- Right Section -->
  <div class="right-links">
  <a href="{{ base_path }}sitemap">{% if language.getId() == 'hi' %}साइट मैप{% else %}Sitemap{% endif %}</a> |
  <a href="#mainSec" class="hide skiptomain">{% if language.getId() == 'hi' %}मुख्य सामग्री पर जाएं{% else %}Skip to Main Content{% endif %}</a>
	<!--<a class="hide" href="{{ base_path }}screen-reader-access">{% if language.getId() == 'hi' %}स्क्रीन रीडर पहुँच{% else %}Screen Reader Access{% endif %}</a> |-->
  
  <!-- Language Toggle -->
  <div class="language-toggle">
    {% if language.getId() == 'hi' %}
      <a href="{{ base_path }}" class="language-switch">English</a>
    {% else %}
      <a href="{{ base_path }}hi" class="language-switch">हिंदी</a>
    {% endif %}
  </div> |

  <!-- Theme Selectors (Inline) -->
  <div class="theme-inline">
    <div class="theme-color blue" data-theme="blue" title="Default Theme"></div>
    <div class="theme-color green" data-theme="green" title="Green Theme"></div>
    <div class="theme-color dark" data-theme="dark" title="Dark Theme"></div>
  </div>
  <div>
    <div class="search_icons_mobile">							
			<div class="nav-item search-btn">
			<a href="javascript:void(0)"><i class="bi bi-search" aria-hidden="true"></i></a>
			</div>
			<div class="searchSection">{{ page.search_section }}</div>
    </div>
  </div>
</div>

</div>

<!-- Logo & Banner Section -->
<div class="logo-bar">
  {{ page.logo }}
</div>

<!-- Main Navigation -->
<nav class="main-nav">
  <ul id="nav-list" class="menu">
    <li class="home-link">
      <a href="{{ base_path }}"><img src="{{ base_path }}themes/sjvn/images/icons/home.svg" alt="Home"></a>
    </li>
    {{ page.primary_menu }}
  </ul>
</nav>


