{% include 'themes/sjvn/templates/form/inauguration-design.html.twig' %}
<!-- Header Include -->

<div id="header-placeholder"></div>
{% include 'themes/sjvn/templates/layout/header.html.twig' %}
<main id="main-content">
  <h1 class="visually-hidden">SJVN Limited Home</h1>
  <!-- Hero section -->
  <section class="banner-region-wrapper" aria-labelledby="hero-heading">
    <h2 id="hero-heading" class="visually-hidden">{% if language.getId() == 'hi' %} मुख्य बैनर {% else %} Main Banner {% endif %}</h2>
    {{ page.banner_section }}
  </section>

  <!-- Announcements Bar -->
  <section class="announcement-bar" aria-labelledby="ann-header">
    <!-- Left Section -->
    <div class="announcement-left">
      <h2 class="announcement-title" id="ann-header">{% if language.getId() == 'hi' %} घोषणाएं {% else %} ANNOUNCEMENTS {% endif
        %}</h2>
      <!-- Controls moved here -->
      <div class="announcement-controls">
        <button type="button" class="ann-prev" aria-label="Previous Announcement"><i class="bi bi-chevron-left"></i><span class="visually-hidden">Previous Announcement</span></button>
        <button type="button" class="ann-pause" aria-label="Pause Announcements"><i class="bi bi-pause-fill"></i><span class="visually-hidden">Pause Announcements</span></button>
        <button type="button" class="ann-next" aria-label="Next Announcement"><i class="bi bi-chevron-right"></i><span class="visually-hidden">Next Announcement</span></button>
      </div>
    </div>
    <div class="announcement-track-wrapper">
      {{ page.announcements }}
    </div>
  </section>
  <!-- About Us Section -->
  <section class="about-section-wrapper" aria-labelledby="about-heading">
    <h2 id="about-heading" class="visually-hidden">{% if language.getId() == 'hi' %} हमारे बारे में {% else %} About Us {% endif %}</h2>
    {{ page.about_us }}
  </section>

  <section class="power-station-section" aria-labelledby="power-station-heading">
    <h2 id="power-station-heading">{% if language.getId() == 'hi' %} हमारे पावर स्टेशन{% else %} Our Power Stations {% endif %}</h2>
    {{ page.our_power_stations }}
  </section>
  <section class="chairman-section-wrapper" aria-labelledby="chairman-heading">
    <h2 id="chairman-heading" class="visually-hidden">{% if language.getId() == 'hi' %} अध्यक्ष का कोना {% else %} Chairman’s Corner {% endif %}</h2>
    {{ page.chairmans_corner }}
  </section>
  <!--news-alert-section-->
  <section class="news-alert-section">
    <div class="news-alert-container">
      <div class="news-column" role="region" aria-labelledby="news-heading">
        <h2 id="news-heading" class="section-heading">{% if language.getId() == 'hi' %} समाचार और मुख्य अंश{% else %}
          News & Highlights {%
          endif %}</h2>
        {{ page.news_highlights }}
      </div>
      <div class="alert-column" role="region" aria-labelledby="alert-heading">
        <h2 id="alert-heading" class="section-heading">{% if language.getId() == 'hi' %} चेतावनी{% else %} Alert {%
          endif %}</h2>
        {{ page.alerts }}
      </div>
    </div>
  </section>
  <!--news-alert-section-end-->
  <section class="our-business-section" aria-labelledby="business-heading">
    <h2 id="business-heading" class="section-title">{% if language.getId() == 'hi' %} हमारा व्यापार{% else %} Our Business {% endif %}</h2>
    {{ page.our_business }}
  </section>
  <section class="quick-links-section" aria-labelledby="quick-links-heading">
    <h2 id="quick-links-heading" class="quick-action-section-heading">{% if language.getId() == 'hi' %} त्वरित पहुँच लिंक{% else %} Quick Access
      Link {% endif %}</h2>

    {{ page.quick_access_links }}
  </section>
  <section class="photo-gallery-section" aria-labelledby="gallery-heading">
    <h2 id="gallery-heading" class="gallery-section-heading">{% if language.getId() == 'hi' %} फोटो गैलरी {% else %} Photo Gallery {% endif
      %}</h2>
    {{ page.photo_gallery }}
  </section>
  <section class="logo-carousel-section" aria-labelledby="important-links-heading">
    <div class="logo-carousel-header">
      <h2 id="important-links-heading">{% if language.getId() == 'hi' %} महत्वपूर्ण लिंक {% else %} Important Links {% endif %}</h2>
      <div class="logo-carousel-controls">
        <button type="button" id="logo-play-pause" class="logo-play-pause-btn" aria-label="Pause/Play Carousel"><i class="bi bi-pause-fill"></i></button>
      </div>
    </div>
    <div class="logo-carousel-track-wrapper">
      <div class="carousel-track">
        {{ page.logo_carousel }}
      </div>
    </div>
  </section>
</main>

<!-- Footer Include -->
<div id="footer-placeholder"></div>

{% include 'themes/sjvn/templates/layout/footer.html.twig' %}