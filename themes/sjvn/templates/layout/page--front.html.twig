<!-- Header Include -->
<div id="header-placeholder"></div>
{% include 'themes/sjvn/templates/layout/header.html.twig' %}
<main id="main-content">
  <h1 class="visually-hidden">SJVN Limited Home</h1>
  <!-- Hero section -->
  <div class="banner-region-wrapper">
    {{ page.banner_section }}
  </div>

  <!-- Announcements Bar -->
  <section class="announcement-bar" id="mainSec" aria-label="Announcements">
    <!-- Left Section -->
    <div class="announcement-left">
      <h2 class="announcement-title">{% if language.getId() == 'hi' %} घोषणाएं {% else %} ANNOUNCEMENTS {% endif
        %}</h2>
      <!-- Controls moved here -->
      <div class="announcement-controls">
        <button type="button" class="ann-prev" aria-label="Previous Announcement">⟨<span class="visually-hidden">Previous Announcement</span></button>
        <button type="button" class="ann-pause" aria-label="Pause Announcements">⏸<span class="visually-hidden">Pause Announcements</span></button>
        <button type="button" class="ann-next" aria-label="Next Announcement">⟩<span class="visually-hidden">Next Announcement</span></button>
      </div>
    </div>
    <div class="announcement-track-wrapper">
      {{ page.announcements }}
    </div>
  </section>
  <!-- About Us Section -->
  <div class="about-section-wrapper">
    {{ page.about_us }}
  </div>

  <section class="power-station-section">
    <h2>{% if language.getId() == 'hi' %} हमारे पावर स्टेशन{% else %} Our Power Stations {% endif %}</h2>
    {{ page.our_power_stations }}
  </section>
  <div class="chairman-section-wrapper">
    {{ page.chairmans_corner }}
  </div>
  <!--news-alert-section-->
  <section class="news-alert-section">
    <div class="news-alert-container">
      <div class="news-column" role="region" aria-labelledby="news-heading">
        <h2 id="news-heading" class="section-heading">{% if language.getId() == 'hi' %} समाचार और मुख्य अंश{% else %}
          News & Highlights {%
          endif %}</h2>
        {{ page.news_highlights }}
      </div>
      <div class="alert-column" role="region" aria-labelledby="alert-heading">
        <h2 id="alert-heading" class="section-heading">{% if language.getId() == 'hi' %} चेतावनी{% else %} Alert {%
          endif %}</h2>
        {{ page.alerts }}
      </div>
    </div>
  </section>
  <!--news-alert-section-end-->
  <section class="our-business-section">
    <h2 class="section-title">{% if language.getId() == 'hi' %} हमारा व्यापार{% else %} Our Business {% endif %}</h2>
    {{ page.our_business }}
  </section>
  <section class="quick-links-section">
    <h2 class="quick-action-section-heading">{% if language.getId() == 'hi' %} त्वरित पहुँच लिंक{% else %} Quick Access
      Link {% endif %}</h2>

    {{ page.quick_access_links }}
  </section>
  <section class="photo-gallery-section">
    <h2 class="gallery-section-heading">{% if language.getId() == 'hi' %} फोटो गैलरी {% else %} Photo Gallery {% endif
      %}</h2>
    {{ page.photo_gallery }}
  </section>
  <div class="logo-carousel-section">
    <div class="carousel-track">
      {{ page.logo_carousel }}
    </div>
  </div>
</main>

<!-- Footer Include -->
<div id="footer-placeholder"></div>

{% include 'themes/sjvn/templates/layout/footer.html.twig' %}