{{ attach_library('sjvn/our-business-tabs') }}


<div class="row mt-4 mb-5">

  <div class="col-md-3 col-lg-3 col-xxl-2">
    <div id="accordionSidebar">

      {% set grouped = {} %}
      {% for group_item in node.field_group_content %}
        {% set group_paragraph = group_item.entity %}
        {% if not group_paragraph.field_group_link_order.value %}
          {% set group_name = group_paragraph.field_group_name.entity.label %}
          {% if grouped[group_name] is not defined %}
            {% set grouped = grouped|merge({ (group_name): [] }) %}
          {% endif %}
          {% set grouped = grouped|merge({ (group_name): grouped[group_name]|merge([group_paragraph]) }) %}
        {% endif %}
      {% endfor %}

      {% set group_index = 0 %}
      {% for group_name, items in grouped %}
        {% set group_index = group_index + 1 %}
        <div class="card">
          <div class="card-header" id="business-heading-{{ group_index }}">
            <a href="#" class="btn-link"
               data-bs-toggle="collapse"
               data-bs-target="#business-group-links-{{ group_index }}"
               aria-expanded="false"
               aria-controls="business-group-links-{{ group_index }}">
              {{ group_name }}
            </a>
          </div>
          <div id="business-group-links-{{ group_index }}"
               class="collapse"
               aria-labelledby="business-heading-{{ group_index }}"
               data-bs-parent="#accordionSidebar">
            <div class="card-body p-1">
              <ul class="list-unstyled">
                {% set paragraph_index = 0 %}
                {% for paragraph in items %}
                  {% set paragraph_index = paragraph_index + 1 %}
                  {% set child_index = 0 %}
                  {% for add_item in paragraph.field_add_content %}
                    {% set add_paragraph = add_item.entity %}
                    {% set child_index = child_index + 1 %}
                    {% set sidebar_title = add_paragraph.field_group_title.value ?: '' %}
                    {% set has_description = add_paragraph.field_descriptions.value %}
                    {% set has_link = add_paragraph.field_link.uri %}
                    {% set has_files = add_paragraph.field_upload_files|length %}
                    {% set first_file = has_files ? add_paragraph.field_upload_files|first : null %}
                    {% set first_file_uri = first_file ? first_file.entity.fileuri : null %}
                    {% if not has_description and (has_link or first_file_uri) %}
                      <li>
                        {% if has_link %}
                          <a href="{{ add_paragraph.field_link.uri }}" target="_blank" rel="noopener">
                            {{ sidebar_title }}
                          </a>
                        {% else %}
                          <a href="{{ file_url(first_file_uri) }}" target="_blank" rel="noopener">
                            {{ sidebar_title }}
                          </a>
                        {% endif %}
                      </li>
                    {% else %}
                      <li>
                        <a href="#sidebar-tab-{{ group_index }}-{{ paragraph_index }}-{{ child_index }}" class="sidebar-tab-link">
                          {{ sidebar_title }}
                        </a>
                      </li>
                    {% endif %}
                  {% endfor %}
                {% endfor %}
              </ul>
            </div>
          </div>
        </div>
      {% endfor %}

    </div> 
  </div>

  <div class="col-md-9 cl-lg-9 col-xxl-10" >
    <div class="top-taps-contents" >
    <ul class="nav nav-tabs" role="tablist">
      {% set first_top_tab = true %}
      {% for group_item in node.field_group_content %}
        {% set group_paragraph = group_item.entity %}
        {% if group_paragraph.field_group_link_order.value %}
          {% for add_item in group_paragraph.field_add_content %}
            {% set add_paragraph = add_item.entity %}
            <li class="nav-item" role="presentation">
              <a class="nav-link {% if first_top_tab %}active{% endif %}" 
                 data-bs-toggle="tab"
                 role="tab"
                 aria-selected="{% if first_top_tab %}true{% else %}false{% endif %}"
                 aria-controls="top-tab-{{ loop.parent.loop.index }}-{{ loop.index }}"
                 id="top-tab-link-{{ loop.parent.loop.index }}-{{ loop.index }}"
                 href="#top-tab-{{ loop.parent.loop.index }}-{{ loop.index }}">
                {{ add_paragraph.field_group_title.value ?: '' }}
              </a>
            </li>
            {% set first_top_tab = false %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </ul>

    <div class="tab-content mt-3 top-tab-content-wrapper">
      {% set first_top_tab_content = true %}
      {% for group_item in node.field_group_content %}
        {% set group_paragraph = group_item.entity %}
        {% if group_paragraph.field_group_link_order.value %}
          {% for add_item in group_paragraph.field_add_content %}
            {% set add_paragraph = add_item.entity %}
            <div class="tab-pane fade {% if first_top_tab_content %}show active{% endif %}" 
                 id="top-tab-{{ loop.parent.loop.index }}-{{ loop.index }}">
              {% if add_paragraph.field_descriptions.value %}
                <div class="group-descriptions">{{ add_paragraph.field_descriptions.value|raw }}</div>
              {% endif %}
              
            </div>
            {% set first_top_tab_content = false %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </div>
</div>
    <div class="tab-content mt-3 sidebar-tab-content sidebar-tab-content-wrapper d-none">
      {% set first_sidebar_tab_content = true %}
      {% set group_index = 0 %}
      {% for group_name, items in grouped %}
        {% set group_index = group_index + 1 %}
        {% set paragraph_index = 0 %}
        {% for paragraph in items %}
          {% set paragraph_index = paragraph_index + 1 %}
          {% set child_index = 0 %}
          {% for add_item in paragraph.field_add_content %}
            {% set add_paragraph = add_item.entity %}
            {% set child_index = child_index + 1 %}
            {% set sidebar_title = add_paragraph.field_group_title.value ?: '' %}
            {% if add_paragraph.field_descriptions.value %}
              <div class="tab-pane fade {% if first_sidebar_tab_content %}show active{% endif %}" 
                   id="sidebar-tab-{{ group_index }}-{{ paragraph_index }}-{{ child_index }}">
                <div class="group-descriptions">{{ add_paragraph.field_descriptions.value|raw }}</div>
              </div>
              {% set first_sidebar_tab_content = false %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% endfor %}
    </div>

  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sidebarLinks = document.querySelectorAll('.sidebar-tab-link');
  const topTabs = document.querySelectorAll('.nav-tabs .nav-link');
  const topWrapper = document.querySelector('.top-tab-content-wrapper');
  const sidebarWrapper = document.querySelector('.sidebar-tab-content-wrapper');

  const showSidebarContent = () => {
    sidebarWrapper.classList.remove('d-none');
    topWrapper.classList.add('d-none');
  };

  const showTopContent = () => {
    topWrapper.classList.remove('d-none');
    sidebarWrapper.classList.add('d-none');
  };

  showTopContent();

  sidebarLinks.forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      document.querySelectorAll('.sidebar-tab-content .tab-pane').forEach(p => p.classList.remove('show', 'active'));
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.classList.add('show', 'active');
        showSidebarContent();
      }
    });
  });

  topTabs.forEach(tab => {
    tab.addEventListener('click', showTopContent);
  });
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const rightColumn = document.querySelector('.top-taps-contents');

  document.querySelectorAll('.sidebar-tab-link').forEach(link => {
    link.addEventListener('click', function() {
      if (rightColumn) {
        rightColumn.style.display = 'none'; // hide the entire right column
      }
    });
  });
});

//-------------------------- Active accordian header--------------------------------//

document.querySelectorAll("#accordionSidebar .list-unstyled a").forEach(link => {
  link.addEventListener("click", function () {
    // Remove active from all li
    document.querySelectorAll("#accordionSidebar .list-unstyled a").forEach(l =>
      l.classList.remove("active")
    );
    // Add active to clicked li
    this.classList.add("active");

    // Remove active-header class from all cards
    document.querySelectorAll("#accordionSidebar .card").forEach(card =>
      card.classList.remove("active-header")
    );

    // Add active-header to the parent .card
    this.closest(".card").classList.add("active-header");
  });
});

</script>
