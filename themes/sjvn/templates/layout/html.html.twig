{#
/**
 * @file
 * Theme override for the basic structure of a single Drupal page.
 *
 * Variables:
 * - logged_in: A flag indicating if user is logged in.
 * - root_path: The root path of the current page (e.g., node, admin, user).
 * - node_type: The content type for the current node, if the page is a node.
 * - head_title: List of text elements that make up the head_title variable.
 *   May contain one or more of the following:
 *   - title: The title of the page.
 *   - name: The name of the site.
 *   - slogan: The slogan of the site.
 * - page_top: Initial rendered markup. This should be printed before 'page'.
 * - page: The rendered page markup.
 * - page_bottom: Closing rendered markup. This variable should be printed after
 *   'page'.
 * - db_offline: A flag indicating if the database is offline.
 * - placeholder_token: The token for generating head, css, js and js-bottom
 *   placeholders.
 *
 * @see template_preprocess_html()
 */
#}
{%
  set body_classes = [
    logged_in ? 'user-logged-in',
    not root_path ? 'path-frontpage' : 'path-' ~ root_path|clean_class,
    node_type ? 'page-node-type-' ~ node_type|clean_class,
    db_offline ? 'db-offline',
  ]
%}
<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>
  <body{{ attributes.addClass(body_classes) }}>
    {#
      Keyboard navigation/accessibility link to main content section in
      page.html.twig.
    #}
    <a href="#main-content" class="visually-hidden focusable skip-link">
      {{ 'Skip to main content'|t }}
    </a>
    {{ page_top }}
    {{ page }}
    {{ page_bottom }}
    
    {# Accessibility Widget #}
    <button id="accessibility-trigger" class="accessibility-trigger" aria-label="Accessibility Options" aria-expanded="false" title="Accessibility Options">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 22" fill="none" aria-hidden="true">
        <path d="M11.625 0C13.0458 0 14.2083 0.975 14.2083 2.16667C14.2083 3.35833 13.0458 4.33333 11.625 4.33333C10.2042 4.33333 9.04167 3.35833 9.04167 2.16667C9.04167 0.975 10.2042 0 11.625 0ZM23.25 7.58333H15.5V21.6667H12.9167V15.1667H10.3333V21.6667H7.75V7.58333H0V5.41667H23.25V7.58333Z" fill="currentColor"/>
      </svg>
    </button>

    {# Back to Top Button with Progress Indicator #}
    <button id="back-to-top" class="back-to-top" aria-label="Back to Top" title="Back to Top">
      <svg class="progress-ring" width="100%" height="100%" viewBox="0 0 100 100">
        <!-- Background Circle: Slightly smaller so border doesn't overlap weirdly -->
        <circle class="progress-ring-bg" cx="50" cy="50" r="46" stroke="none" stroke-width="0" fill="var(--primary-color, #009edb)" />
        <!-- Progress Border: Sits on top/edge -->
        <circle class="progress-ring-path" cx="50" cy="50" r="46" stroke-width="4" fill="none" stroke="var(--secondary-color, #fdb913)" />
      </svg>
      <span class="icon-container">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 15l-6-6-6 6"/>
        </svg>
      </span>
    </button>

    {# Social Media Icons - Fixed Position Below Accessibility #}
    <div class="social-media-fixed">
      <a href="https://www.youtube.com/@sjvnlindia" class="social-youtube" target="_blank" rel="noopener noreferrer" aria-label="Visit our YouTube Channel" title="YouTube">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
      </a>
      <a href="https://www.facebook.com/SJVNLtd" class="social-facebook" target="_blank" rel="noopener noreferrer" aria-label="Visit our Facebook Page" title="Facebook">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
      </a>
      <a href="https://x.com/SjvnLimited" class="social-twitter" target="_blank" rel="noopener noreferrer" aria-label="Visit our X (Twitter) Page" title="X (Twitter)">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    </div>

    <div id="accessibility-drawer" class="accessibility-drawer" role="dialog" aria-labelledby="accessibility-drawer-title" aria-hidden="true">
      <div class="accessibility-drawer-header">
        <h2 id="accessibility-drawer-title">Accessibility Options</h2>
        <button id="accessibility-close" class="accessibility-close" aria-label="Close Accessibility Options">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      
      <div class="accessibility-drawer-content">
        {# Text Size Section #}
        <div class="accessibility-section">
          <h3>Text Size</h3>
          <div class="button-group horizontal">
            <button data-action="text-decrease" aria-label="Decrease Text Size">A-</button>
            <button data-action="text-normal" class="active" aria-label="Normal Text Size">A</button>
            <button data-action="text-increase" aria-label="Increase Text Size">A+</button>
          </div>
        </div>

        {# Theme Section #}
        <div class="accessibility-section">
          <h3>Theme</h3>
          <div class="radio-group">
            <label class="radio-option active">
              <input type="radio" name="theme" value="light" checked aria-label="Light Theme">
              <span class="radio-label">Light Theme</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="theme" value="dark" aria-label="Dark Theme">
              <span class="radio-label">Dark Theme</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="theme" value="high-contrast" aria-label="High Contrast Theme">
              <span class="radio-label">High Contrast</span>
            </label>
          </div>
        </div>

        {# Cursor Size Section #}
        <div class="accessibility-section">
          <h3>Cursor Size</h3>
          <div class="radio-group">
            <label class="radio-option">
              <input type="radio" name="cursor" value="small" aria-label="Small Cursor">
              <span class="radio-label">Small Cursor</span>
            </label>
            <label class="radio-option active">
              <input type="radio" name="cursor" value="normal" checked aria-label="Normal Cursor">
              <span class="radio-label">Normal Cursor</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="cursor" value="large" aria-label="Large Cursor">
              <span class="radio-label">Large Cursor</span>
            </label>
          </div>
        </div>

        {# Line Height Section #}
        <div class="accessibility-section">
          <h3>Line Height</h3>
          <div class="radio-group">
            <label class="radio-option">
              <input type="radio" name="line-height" value="tight" aria-label="Tight Line Height">
              <span class="radio-label">Tight</span>
            </label>
            <label class="radio-option active">
              <input type="radio" name="line-height" value="normal" checked aria-label="Normal Line Height">
              <span class="radio-label">Normal</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="line-height" value="loose" aria-label="Loose Line Height">
              <span class="radio-label">Loose</span>
            </label>
          </div>
        </div>

        {# Text Alignment Section #}
        <div class="accessibility-section">
          <h3>Text Alignment</h3>
          <div class="button-group horizontal">
            <button data-action="align-left" class="active icon-btn" aria-label="Align Text Left">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="17" y1="10" x2="3" y2="10"></line>
                <line x1="21" y1="6" x2="3" y2="6"></line>
                <line x1="21" y1="14" x2="3" y2="14"></line>
                <line x1="17" y1="18" x2="3" y2="18"></line>
              </svg>
            </button>
            <button data-action="align-center" class="icon-btn" aria-label="Align Text Center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="18" y1="10" x2="6" y2="10"></line>
                <line x1="21" y1="6" x2="3" y2="6"></line>
                <line x1="21" y1="14" x2="3" y2="14"></line>
                <line x1="18" y1="18" x2="6" y2="18"></line>
              </svg>
            </button>
            <button data-action="align-right" class="icon-btn" aria-label="Align Text Right">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="21" y1="10" x2="7" y2="10"></line>
                <line x1="21" y1="6" x2="3" y2="6"></line>
                <line x1="21" y1="14" x2="3" y2="14"></line>
                <line x1="21" y1="18" x2="7" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>

        {# Text Spacing Section #}
        <div class="accessibility-section">
          <h3>Text Spacing</h3>
          <div class="radio-group">
            <label class="radio-option">
              <input type="radio" name="text-spacing" value="tight" aria-label="Tight Text Spacing">
              <span class="radio-label">Tight Spacing</span>
            </label>
            <label class="radio-option active">
              <input type="radio" name="text-spacing" value="normal" checked aria-label="Normal Text Spacing">
              <span class="radio-label">Normal Spacing</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="text-spacing" value="loose" aria-label="Loose Text Spacing">
              <span class="radio-label">Loose Spacing</span>
            </label>
          </div>
        </div>

        {# Visual Options Section #}
        <div class="accessibility-section">
          <h3>Visual Options</h3>
          <div class="checkbox-group">
            <label class="checkbox-option">
              <input type="checkbox" name="hide-images" aria-label="Hide Images">
              <span class="checkbox-label">Hide Images</span>
            </label>
            <label class="checkbox-option">
              <input type="checkbox" name="highlight-links" aria-label="Highlight Links">
              <span class="checkbox-label">Highlight Links</span>
            </label>
          </div>
        </div>

        {# Quick Actions Section #}
        <div class="accessibility-section">
          <h3>Quick Actions</h3>
          <div class="action-buttons">
            <button data-action="skip-to-main" class="action-btn">Skip to Main Content</button>
            <button data-action="back-to-top" class="action-btn">Back to Top</button>
            <button data-action="reset-all" class="action-btn">Reset All Settings</button>
          </div>
        </div>
      </div>
    </div>
    <div id="accessibility-overlay" class="accessibility-overlay" aria-hidden="true"></div>
    
    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>
