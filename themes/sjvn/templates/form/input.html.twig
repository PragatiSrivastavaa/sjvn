{#
/**
 * @file
 * Theme override for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 * - is_submit: Boolean flag indicating if this is a submit button.
 * - button_text: The label text for the button.
 *
 * @see template_preprocess_input()
 */
#}
{% if is_submit %}
  <button{{ attributes.removeClass('form-submit') }} aria-label="{{ button_text }}">{{ button_text }}</button>
{% else %}

  <input{{ attributes }} />
{% endif %}
{{ children }}
