{# 
  SJVN Curtain Animation Overlay
  Included in page--front.html.twig
  Curtains with interactive Click Now button and soft confetti bursts.
#}
<!-- Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,700;1,700&family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --red-curtain: #b50606;
        --red-curtain-dark: #7a0000;
        --red-curtain-light: #e60000;
        --gold: #d4af37;
        --gold-glow: rgba(212, 175, 55, 0.4);
    }

    #inauguration-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: transparent;
        z-index: 999999;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        transition: opacity 0.8s ease-out, visibility 0.8s;
    }

    #inauguration-modal-overlay.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    body.sjvn-modal-active {
        overflow: hidden !important;
        height: 100vh;
    }

    .main-container-overlay {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        margin: 0;
        perspective: 2000px;
    }

    .banner-card-overlay {
        background: transparent;
        width: 100%;
        height: 100%;
        position: relative;
        display: flex;
        overflow: hidden;
    }

    /* Interaction Center Stage */
    .interaction-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 100;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px; /* Tighter gap for better vertical stacking */
        transition: all 0.5s ease-in-out;
        width: 90%;
    }

    .curtain-open .interaction-center {
        opacity: 0;
        transform: translate(-50%, -60%) scale(0.8);
        pointer-events: none;
    }

    .sjvn-welcome-text {
        font-family: 'Outfit', sans-serif;
        font-size: 3rem; /* Increased from 1.8rem */
        font-weight: 700;
        color: white;
        letter-spacing: 6px;
        margin: 0;
        text-transform: uppercase;
    }

    .sjvn-to-text {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 3rem; /* Increased from 2rem */
        color: rgba(255, 255, 255, 0.9);
        margin: 5px 0;
    }

    .sjvn-stage-text {
        font-family: 'Cormorant Garamond', serif;
        font-size: 5rem; /* Increased from 4rem */
        font-weight: 800;
        color: white;
        text-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        letter-spacing: 2px;
        margin: 0;
        background: linear-gradient(to bottom, #fff7e0, #d4af37);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: textFloat 3s ease-in-out infinite alternate;
    }

    .sjvn-subtitle {
        font-family: 'Outfit', sans-serif;
        font-size: 2rem; /* Increased from 1.2rem */
        color: rgba(255, 255, 255, 1);
        letter-spacing: 6px;
        font-weight: 700;
        margin: 15px 0;
        text-transform: uppercase;
    }

    .click-now-btn {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #ffd700, #996515);
        border: 4px solid white;
        color: white;
        font-family: 'Outfit', sans-serif;
        font-size: 1.1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), 0 0 0 10px var(--gold-glow);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        animation: pulseButton 2s infinite;
        outline: none;
        margin-top: 20px;
    }

    .click-now-btn:hover {
        transform: scale(1.1);
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.8), 0 0 0 20px var(--gold-glow);
    }

    @keyframes pulseButton {
        0% { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), 0 0 0 0px var(--gold-glow); }
        70% { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), 0 0 0 20px rgba(212, 175, 55, 0); }
        100% { box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), 0 0 0 0px rgba(212, 175, 55, 0); }
    }

    @keyframes textFloat { from { transform: translateY(0); } to { transform: translateY(-10px); } }

    /* Curtain components */
    .curtain-container-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        z-index: 50;
        pointer-events: none;
    }

    .curtain-left, .curtain-right {
        height: 100%;
        width: 50%;
        transition: transform 3.5s cubic-bezier(0.645, 0.045, 0.355, 1), clip-path 3.5s cubic-bezier(0.645, 0.045, 0.355, 1);
        background: var(--red-curtain);
        box-shadow: inset 0 0 150px rgba(0, 0, 0, 0.8);
        position: relative;
    }

    .curtain-left { background: linear-gradient(135deg, var(--red-curtain-dark), var(--red-curtain)); transform-origin: left; }
    .curtain-right { background: linear-gradient(-135deg, var(--red-curtain-dark), var(--red-curtain)); transform-origin: right; }

    .curtain-folds {
        position: absolute;
        inset: 0;
        background-image: repeating-linear-gradient(to right, rgba(0, 0, 0, 0.25) 0px, transparent 35px);
        opacity: 0.2;
    }

    /* Opening Animation */
    .curtain-open .curtain-left { transform: translateX(-100%) rotateY(-20deg); }
    .curtain-open .curtain-right { transform: translateX(100%) rotateY(20deg); }

    .curtain-rod {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 25px;
        background: linear-gradient(to bottom, #d4af37, #996515, #d4af37);
        z-index: 70;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    }

    /* Confetti falling to center from corners */
    #celebration-cracker-canvas {
        position: absolute;
        inset: 0;
        z-index: 80;
        pointer-events: none;
    }

    .confetti-particle {
        position: absolute;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        pointer-events: none;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

</style>

<div id="inauguration-modal-overlay">
    <div class="main-container-overlay">
        <div class="banner-card-overlay" id="sjvn-banner-card">
            
            <!-- Curtain Rod -->
            <div class="curtain-rod"></div>

            <!-- Interaction Zone -->
            <div class="interaction-center" id="sjvn-interaction-center">
                <h2 class="sjvn-welcome-text">WELCOME</h2>
                <div class="sjvn-to-text">To</div>
                <h1 class="sjvn-stage-text">SJVN Limited</h1>
                <p class="sjvn-subtitle">A NAVRATNA CPSE</p>
                
                <button class="click-now-btn" id="sjvn-curtain-trigger">
                    CLICK NOW
                </button>
                
                <p style="color: #f1d592; font-size: 1.4rem; margin-top: 15px; letter-spacing: 2px; font-weight: 500;">Tap to unveil our new website</p>
            </div>

            <!-- Confetti / Animation Canvas -->
            <div id="celebration-cracker-canvas"></div>

            <!-- Curtain System -->
            <div class="curtain-container-overlay">
                <div class="curtain-left"><div class="curtain-folds"></div></div>
                <div class="curtain-right"><div class="curtain-folds"></div></div>
            </div>

        </div>
    </div>
</div>

<script>
    (function() {
        document.addEventListener('DOMContentLoaded', () => {
            const overlay = document.getElementById('inauguration-modal-overlay');
            const card = document.getElementById('sjvn-banner-card');
            const trigger = document.getElementById('sjvn-curtain-trigger');
            const canvas = document.getElementById('celebration-cracker-canvas');

            let animationInterval;

            // Apply body lock to prevent scrolling
            document.body.classList.add('sjvn-modal-active');

            // Start Confetti Bursts (Only 1-2 times while closed)
            setTimeout(() => shootConfetti('left'), 800);
            setTimeout(() => shootConfetti('right'), 800);
            setTimeout(() => shootConfetti('left'), 2500);
            setTimeout(() => shootConfetti('right'), 2500);

            // Click listener
            trigger.addEventListener('click', () => {
                card.classList.add('curtain-open');

                // Burst when curtains open (1st time)
                shootConfetti('left');
                shootConfetti('right');

                // Burst again as curtains are opening (2nd time)
                setTimeout(() => {
                    shootConfetti('left');
                    shootConfetti('right');
                }, 800);
                
                setTimeout(() => {
                    overlay.style.opacity = '0';
                    setTimeout(() => {
                        overlay.classList.add('hidden');
                        document.body.classList.remove('sjvn-modal-active');
                    }, 500);
                }, 3500);
            });

            function shootConfetti(side) {
                const particleCount = 15;
                const colors = ['#ffd700', '#ffffff', '#ff4500', '#009edb', '#ff69b4', '#8a2be2'];
                
                for (let i = 0; i < particleCount; i++) {
                    const el = document.createElement('div');
                    el.className = 'confetti-particle';
                    const color = colors[Math.floor(Math.random() * colors.length)];
                    el.style.backgroundColor = color;
                    
                    canvas.appendChild(el);

                    const startX = side === 'left' ? -5 : 105;
                    const startY = 100;

                    const targetX = 50 + (Math.random() * 40 - 20);
                    const targetY = 30 + (Math.random() * 40 - 20);
                    const rotation = Math.random() * 360;

                    el.style.left = startX + '%';
                    el.style.top = startY + '%';
                    el.style.transform = `rotate(${rotation}deg)`;

                    const duration = 2000 + Math.random() * 2000;

                    const animation = el.animate([
                        { left: startX + '%', top: startY + '%', transform: `rotate(0deg) scale(0)`, opacity: 0 },
                        { opacity: 1, offset: 0.2 },
                        { left: targetX + '%', top: targetY + '%', transform: `rotate(${rotation}deg) scale(1.2)`, opacity: 1, offset: 0.5 },
                        { left: (targetX + (Math.random() * 20 - 10)) + '%', top: (targetY + 30) + '%', transform: `rotate(${rotation + 180}deg) scale(0)`, opacity: 0 }
                    ], {
                        duration: duration,
                        easing: 'ease-out'
                    });

                    animation.onfinish = () => el.remove();
                }
            }
        });
    })();
</script>
