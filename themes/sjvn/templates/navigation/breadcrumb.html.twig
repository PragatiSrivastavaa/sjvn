{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items.
 */
#}
{% if breadcrumb %}
  <nav class="breadcrumb" aria-labelledby="system-breadcrumb">
    <h2 id="system-breadcrumb" class="visually-hidden">{{ 'Breadcrumb'|t }}</h2>
    <div class="breadcrumb__list">
      <span class="breadcrumb__item">
        <a href="/" class="breadcrumb__link">
          <i class="bi bi-house" aria-hidden="true"></i>
          <span class="visually-hidden">{{ 'Home'|t }}</span>
        </a>
      </span>
    {% for item in breadcrumb %}
      <span class="breadcrumb__item{{ loop.last ? ' is-active' : '' }}">
        {% if item.url and not loop.last %}
          <a href="{{ item.url }}" class="breadcrumb__link">{{ item.text }}</a>
        {% else %}
          <span class="breadcrumb__text" aria-current="page">{{ item.text }}</span>
        {% endif %}
      </span>
    {% endfor %}
    </div>
  </nav>
{% endif %}



