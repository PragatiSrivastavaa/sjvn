/**
 * Implements hook_preprocess_image_widget().
 */
function sjvn_preprocess_image_widget(array &$variables) {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}


function sjvn_preprocess_page(&$variables) {
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $vars['language'] = $language;

  if (!empty($_SESSION['saltval']) && !empty($_SESSION['matchval']) && ($_SESSION['saltval'] == $_SESSION['matchval'])) {
    $variables['randval'] = $_SESSION['saltval'];
    $_SESSION['matchval'] = $variables['randval'];
  } else {
    $_SESSION['saltval'] = random_string();
    $_SESSION['matchval'] = $_SESSION['saltval'];
    $variables['randval'] = $_SESSION['saltval'];
  }
  $variables['#cache']['max-age'] = 0;
  global $base_url;
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $vars['language'] = $language;

// for custom banner image per section
// Define mapping between content type/view IDs and block titles.
  $banner_map = [
    // Content types
  'board_of_directors' => 'Board of Directors',
  'our_business' => 'Our Business',
  'photo_gallery' => 'Photo Gallery',
  'video_gallery' => 'Photo Gallery', 
  'news_announcement' => 'News Announcement',
  'investor_relations' => 'Investor Relations',
  'career' => 'career',
  'key_executive' => 'Key Executive',

  // Views (their machine names)
  'board_of_directors' => 'Board of Directors',
  'our_project' => 'Our Business',         // ✅ view ID for Our Business
  'photo_gallery' => 'Photo Gallery',            // ✅ if your photo gallery view ID is "gallery"
  'video_gallery' => 'Photo Gallery', 
  'announcements' => 'News Announcement',   // ✅ view ID for News
  'investor_relations' => 'Investor Relations',
  'current_job' => 'career',
  'key_executive' => 'Key Executive',
];
  

  $matched_key = NULL;

  // 1️⃣ Detect content type page
  if (!empty($variables['node'])) {
    $bundle = $variables['node']->bundle();
    if (isset($banner_map[$bundle])) {
      $matched_key = $bundle;
    }
  }

  // 2️⃣ Detect Views page (like /board-of-directors)
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (preg_match('/^view\.(.*?)\.page_/', $route_name, $matches)) {
    $view_id = $matches[1];
    if (isset($banner_map[$view_id])) {
      $matched_key = $view_id;
    }
  }

  // 3️⃣ If a matching section found, load that block's image
  if ($matched_key) {
    $block_title = $banner_map[$matched_key];
    $blocks = \Drupal::entityTypeManager()
      ->getStorage('block_content')
      ->loadByProperties(['info' => $block_title]);

    if ($block = reset($blocks)) {
      $image_field = $block->get('field_banner_image');
      if (!$image_field->isEmpty()) {
        $file = $image_field->entity;
        if ($file) {
          $variables['section_banner_image'] = \Drupal::service('file_url_generator')
            ->generateAbsoluteString($file->getFileUri());
          $variables['section_banner_alt'] = $image_field->alt;
        }
      }
    }
  }

// for total visit count
  if (\Drupal::moduleHandler()->moduleExists('counter')) {
    /** @var \Drupal\counter\CounterUtility $counter_utility */
    $counter_utility = \Drupal::service('counter.counter_utility');

    // Total visitors.
    $total_visitors = $counter_utility->getVisitorData();

    // Unique visitors.
    $unique_visitors = $counter_utility->getUniqueVisitorData();

    // Pass variables to Twig.
    $variables['total_visitors'] = $total_visitors;
    $variables['unique_visitors'] = $unique_visitors;
  }


  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    // Generate a unique ID based on node ID.
    $variables['unique_page_id'] = 'page-' . $node->id();
  }
}
	function random_string()
	{
		$character_set_array = array();
		$character_set_array[] = array('count' => 4, 'characters' => 'abcdefghijklmnopqrstuvwxyz');
		$character_set_array[] = array('count' => 4, 'characters' => '0123456789');
		$temp_array = array();
		foreach ($character_set_array as $character_set) {
			for ($i = 0; $i < $character_set['count']; $i++) {
				$temp_array[] = $character_set['characters'][rand(0, strlen($character_set['characters']) - 1)];
			}
		}
		shuffle($temp_array);
		return implode('', $temp_array);
	}
	
function sjvn_preprocess_html(array &$variables) {
  $account = \Drupal::currentUser();
  foreach ($account->getRoles() as $role) {
    $variables['attributes']['class'][] = 'role-' . $role;
  }

  if ($node = \Drupal::request()->attributes->get('node')) {
    $variables['attributes']['class'][] = 'page-node-' . $node->id();
    // If you meant to use alias, implement it meaningfully or remove the line.
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['attributes']['class'][] = 'lang-' . $langcode;
}

/**
 * Implements hook_preprocess_views_view().
 */
function sjvn_preprocess_views_view(&$variables) {
  
  // Attach board of directors library
  if ($variables['view']->id() === 'board_of_directors') {
    $variables['#attached']['library'][] = 'sjvn/board-of-directors';
  }
  
  // Attach portfolio library
  if ($variables['view']->id() === 'portfolio') {
    $variables['#attached']['library'][] = 'sjvn/portfolio';
  }
  
  $variables['current_language'] = \Drupal::languageManager()->getCurrentLanguage()->getId();

}


function sjvn_preprocess_views_view_unformatted(array &$variables) {
  $variables['current_language'] = \Drupal::languageManager()->getCurrentLanguage()->getId();
}





