<?php

/**
 * @file
 * Functions to support theming.
 */
use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Template\Attribute;
use Drupal\views\Form\ViewsForm;
use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Url;
use Drupal\Core\Database\Database;

/**
 * Implements hook_preprocess_image_widget().
 */
function sjvn_preprocess_image_widget(array &$variables) {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}


function sjvn_preprocess_page(&$variables) {
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $vars['language'] = $language;

  if (!empty($_SESSION['saltval']) && !empty($_SESSION['matchval']) && ($_SESSION['saltval'] == $_SESSION['matchval'])) {
    $variables['randval'] = $_SESSION['saltval'];
    $_SESSION['matchval'] = $variables['randval'];
  } else {
    $_SESSION['saltval'] = random_string();
    $_SESSION['matchval'] = $_SESSION['saltval'];
    $variables['randval'] = $_SESSION['saltval'];
  }
  $variables['#cache']['max-age'] = 0;
  global $base_url;
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $vars['language'] = $language;

}
	function random_string()
	{
		$character_set_array = array();
		$character_set_array[] = array('count' => 4, 'characters' => 'abcdefghijklmnopqrstuvwxyz');
		$character_set_array[] = array('count' => 4, 'characters' => '0123456789');
		$temp_array = array();
		foreach ($character_set_array as $character_set) {
			for ($i = 0; $i < $character_set['count']; $i++) {
				$temp_array[] = $character_set['characters'][rand(0, strlen($character_set['characters']) - 1)];
			}
		}
		shuffle($temp_array);
		return implode('', $temp_array);
	}
	
function sjvn_preprocess_html(array &$variables) {
  $account = \Drupal::currentUser();
  foreach ($account->getRoles() as $role) {
    $variables['attributes']['class'][] = 'role-' . $role;
  }

  if ($node = \Drupal::request()->attributes->get('node')) {
    $variables['attributes']['class'][] = 'page-node-' . $node->id();
    // If you meant to use alias, implement it meaningfully or remove the line.
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['attributes']['class'][] = 'lang-' . $langcode;
}

/**
 * Implements hook_preprocess_views_view().
 */
function sjvn_preprocess_views_view(&$variables) {
  if ($variables['view']->id() === 'visitors' && $variables['view']->current_display === 'block_1') {
    $connection = Database::getConnection();

    // Count distinct visitor_id + page path (so refresh doesn't count, but new page does).
    $query = $connection->select('visitors', 'v');
    $query->addExpression("COUNT(DISTINCT CONCAT_WS('-', v.visitor_id, v.visitors_path))", 'page_hits');
    $total = $query->execute()->fetchField();

    // Add language-based offset.
    $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
    $final_total = ($langcode === 'hi') ? (100 + $total) : (500 + $total);

    $variables['header'] = [
      '#markup' => t('Total visitor: @count', ['@count' => $final_total]),
    ];
  }
  
}


function sjvn_preprocess_views_view_unformatted(&$variables) {
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $vars['language'] = $language;
}