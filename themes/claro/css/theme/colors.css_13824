/**
 * Reusable colors.
 */
.color-success {
  color: #325e1c;
  background-color: #f3faef;
}
.color-warning {
  color: #734c00;
  background-color: #fdf8ed;
}
.color-error {
  color: #a51b00;
  background-color: #fcf4f2;
}
div#edit-field-1-whether-appointed-as-the div:nth-child(1), div#edit-field-2-whether-appointed-as-jud div:nth-child(1) {display:none !important}


#node-judges-form .form-radios.form-boolean-group div:nth-child(1) {display:none !important}

#node-judges-form #edit-field-fromtodate-0 legend.fieldset__legend.fieldset__legend--visible {display: none;}

#node-judges-form .form-item.form-datetime-wrapper {
    display: inline-block;
    padding: 0px 10px 0px 0px;
    margin: 4px;
}

#node-judges-form .form-item--field-name-of-the-high-court label.form-item__label {
    display: inline;
    padding-right: 10px;
}