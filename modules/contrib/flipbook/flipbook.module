<?php

use Drupal\file\Entity\File;
function flip_preprocess_page(&$variables){
    $config = \Drupal::config('config.flipbook_chooseconfig');
    $choice_value = $config->get('pdf.choice');    
    global $base_url;
    $host = $base_url;
    
    // Check if object exists to avoid errors
    if (!isset($variables['element']['#object'])) {
        return;
    }
    
    $object = $variables['element']['#object'];
    $typeLabel = $object->get('name')->getValue();
    $flipbook = $object->get('flipbook')->getValue();
    
    // Get Entity ID for unique identifiers
    $entity_id = $object->id();
    $variables['entity_id'] = $entity_id;

    if (isset($flipbook[0]['target_id'])) {
        $flipdata = $flipbook[0]['target_id'];
        $file1 = File::load($flipdata);
        if ($file1) {
            $url = (\Drupal::hasService('file_url_generator')) ? \Drupal::service('file_url_generator')->generateAbsoluteString($file1->getFileUri()) : file_url_transform_relative(($file1->getFileUri()));
            
            // KEY FIX: Store URL keyed by entity ID so we don't overwrite it
            $variables['#attached']['drupalSettings']['pdf_urls'][$entity_id] = $url;
            // Legacy support (will hold the last one processed, but we won't use it in fixed JS)
            $variables['#attached']['drupalSettings']['pdfpath'] = $url; 
            
            $variables['url'] = $url;
        }
    }

    $flipimage = $object->get('flipbook_cover')->getValue();
    if (isset($flipimage[0]['target_id'])) {
        $file = File::load($flipimage[0]['target_id']);
        if ($file) {
            $coverimageurl = (\Drupal::hasService('file_url_generator')) ? \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri()) : file_url_transform_relative(($file->getFileUri()));
            $variables['bannercover'] = $coverimageurl;
        }
    }

    if($choice_value == 1)
    {
        $variables['#attached']['library'][] = 'flipbook/flipbook';
    }
    else
    {
        $variables['#attached']['library'][] = 'flipbook/flipbook_nopopup';   
    }
    $variables['#attached']['drupalSettings']['modulepath'] = \Drupal::service('extension.list.module')->getPath('flipbook');
    $variables['#attached']['drupalSettings']['pdfchoice'] = $choice_value;
    $variables['#attached']['drupalSettings']['host'] = $host;
    $variables['title'] = isset($typeLabel[0]['value']) ? $typeLabel[0]['value'] : '';
    $variables['pdfchoice']= $choice_value;
}

/**
 * Implements hook_theme()
 */
function flipbook_theme($existing, $type, $theme, $path) {
    return [
        'field__flipbook__flipbook__flipbook' => [
            'template' => 'flipbook',
            'preprocess functions' => ['flip_preprocess_page'],
        ],
        'views_view_field__field_flipbook' => [
            'template' => 'flipbook',
            'preprocess functions' => ['flip_preprocess_page'],
        ],
    ];
}
