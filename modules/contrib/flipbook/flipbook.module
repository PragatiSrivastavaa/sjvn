<?php

/**
 * @file
 * Contains flipbook.module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\file\Entity\File;

/**
 * Implements hook_entity_predelete().
 *
 * Delete associated files when a flipbook entity is deleted.
 */
function flipbook_entity_predelete(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'flipbook') {
    return;
  }

  // Delete the cover image file.
  $cover_target_id = $entity->get('flipbook_cover')->target_id ?? NULL;
  if ($cover_target_id) {
    $file = File::load($cover_target_id);
    if ($file) {
      $file->delete();
    }
  }

  // Delete the PDF file.
  $pdf_target_id = $entity->get('flipbook')->target_id ?? NULL;
  if ($pdf_target_id) {
    $file = File::load($pdf_target_id);
    if ($file) {
      $file->delete();
    }
  }
}

/**
 * Preprocess function for flipbook field.
 */
function flipbook_preprocess_flipbook(array &$variables): void {
  $config = \Drupal::config('config.flipbook_chooseconfig');
  $choice_value = $config->get('pdf.choice');
  $host = \Drupal::request()->getSchemeAndHttpHost();

  $object = $variables['element']['#object'];
  $typeLabel = $object->get('name')->getValue();
  $flipbook = $object->get('flipbook')->getValue();
  $flipdata = $flipbook[0]['target_id'] ?? NULL;

  /** @var \Drupal\Core\File\FileUrlGeneratorInterface $file_url_generator */
  $file_url_generator = \Drupal::service('file_url_generator');

  $url = '';
  if ($flipdata) {
    $file1 = File::load($flipdata);
    if ($file1) {
      $url = $file_url_generator->generateAbsoluteString($file1->getFileUri());
    }
  }

  $flipimage = $object->get('flipbook_cover')->getValue()[0]['target_id'] ?? NULL;
  $coverimageurl = '';
  if ($flipimage) {
    $file = File::load($flipimage);
    if ($file) {
      $coverimageurl = $file_url_generator->generateAbsoluteString($file->getFileUri());
    }
  }

  if ($choice_value == 1) {
    $variables['#attached']['library'][] = 'flipbook/flipbook';
  }
  else {
    $variables['#attached']['library'][] = 'flipbook/flipbook_nopopup';
  }

  $variables['#attached']['drupalSettings']['modulepath'] = \Drupal::service('extension.list.module')->getPath('flipbook');
  $variables['#attached']['drupalSettings']['pdfpath'] = $url;
  $variables['#attached']['drupalSettings']['pdfchoice'] = $choice_value;
  $variables['#attached']['drupalSettings']['host'] = $host;
  $variables['title'] = $typeLabel[0]['value'] ?? '';
  $variables['bannercover'] = $coverimageurl;
  $variables['url'] = $url;
  $variables['pdfchoice'] = $choice_value;
}

/**
 * Implements hook_theme().
 */
function flipbook_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'field__flipbook__flipbook__flipbook' => [
      'template' => 'flipbook',
      'preprocess functions' => ['flipbook_preprocess_flipbook'],
    ],
    'views_view_field__field_flipbook' => [
      'template' => 'flipbook',
      'preprocess functions' => ['flipbook_preprocess_flipbook'],
    ],
  ];
}
