{% if pdfchoice == '1' %}  
    <div class="modal fade" id="flip-book-window-{{ entity_id }}" tabindex="-1" role="dialog" aria-labelledby="headerLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span class="glyphicon glyphicon-remove" aria-hidden="true"></span></button>
                <div class="modal-body">
                    <div class="mount-node">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="books">
        <div class="thumb">
            {# Added Class flipbook-popup-trigger and data-target/data-pdf #}
            <img id="flipbook-img-{{ entity_id }}" 
                 src="{{ bannercover }}" 
                 class="btn flipbook-popup-trigger" 
                 alt="{{ title }}" 
                 data="{{ url }}" 
                 data-pdf="{{ url }}"
                 data-target="#flip-book-window-{{ entity_id }}"
                 data-id="{{ entity_id }}" />
            <div class="caption">
                {{ title }}
            </div>
        </div>
    </div>
{% else %}
    {# Use Class based selector for JS init, and data-pdf for direct URL access #}
    <div class="pdfcontainer flipbook-embed-container" id="container-{{ entity_id }}" data-pdf="{{ url }}">
    </div>
{% endif %}

