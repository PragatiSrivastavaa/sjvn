<?php

use Drupal\Core\Access\AccessResult;
use Drupal\node\NodeInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_node_access().
 */
function sjvn_term_access_node_access(NodeInterface $node, $op, AccountInterface $account) {
    // Only restrict update, delete and clone. View access remains open (public).
    if (!in_array($op, ['update', 'delete', 'clone'])) {
        return AccessResult::neutral();
    }

    // Admins and users with bypass permission are not restricted.
    if ($account->hasPermission('bypass node access') || 
        $account->hasPermission('bypass sjvn category access') || 
        in_array('administrator', $account->getRoles())) {
        return AccessResult::neutral();
    }

    // Check if user is explicitly selected in 'Vendor List' field.
    if ($node->hasField('field_vender_list') && !$node->get('field_vender_list')->isEmpty()) {
        foreach ($node->get('field_vender_list') as $item) {
            if ($item->target_id == $account->id()) {
                // Ensure delete access is NOT granted via this check.
                if ($op !== 'delete') {
                    return AccessResult::allowed()->cachePerUser()->addCacheableDependency($node);
                }
            }
        }
    }

    // Check if user belongs to the same Contract Unit as the tender (Direct or On Behalf Of).
    $node_cu_ids = [];
    if ($node->hasField('field_contract_unit') && !$node->get('field_contract_unit')->isEmpty()) {
        foreach ($node->get('field_contract_unit') as $item) {
            $node_cu_ids[] = $item->target_id;
        }
    }
    if ($node->hasField('field_on_behalf_of') && !$node->get('field_on_behalf_of')->isEmpty()) {
        foreach ($node->get('field_on_behalf_of') as $item) {
            $node_cu_ids[] = $item->target_id;
        }
    }

    if (!empty($node_cu_ids)) {
        // Load full user entity to check fields.
        $user_entity = \Drupal\user\Entity\User::load($account->id());
        if ($user_entity && $user_entity->hasField('field_contract_unit') && !$user_entity->get('field_contract_unit')->isEmpty()) {
            $user_cu_ids = [];
            foreach ($user_entity->get('field_contract_unit') as $item) {
                $user_cu_ids[] = $item->target_id;
            }
            
            if (array_intersect($node_cu_ids, $user_cu_ids)) {
                // Ensure delete access is NOT granted via this check.
                if ($op !== 'delete') {
                    return AccessResult::allowed()->cachePerUser()->addCacheableDependency($node);
                }
            }
        }
    }

    /** @var \Drupal\permissions_by_term\Service\AccessStorage $access_storage */
    $access_storage = \Drupal::service('permissions_by_term.access_storage');
    $user_tids = (array) $access_storage->getPermittedTids($account->id(), $account->getRoles());

    // Also include terms from the user's 'field_contract_unit' profile field.
    $user_entity = \Drupal\user\Entity\User::load($account->id());
    if ($user_entity && $user_entity->hasField('field_contract_unit')) {
        foreach ($user_entity->get('field_contract_unit') as $item) {
            $user_tids[] = $item->target_id;
        }
    }
    $user_tids = array_unique($user_tids);

    // Get the vocabularies configured in Permissions by Term settings.
    $config = \Drupal::config('permissions_by_term.settings');
    $target_vids = $config->get('target_bundles') ?: [];
    
    // Ensure $target_vids is an array.
    if (is_string($target_vids)) {
        $target_vids = str_replace(['[', ']', "'", '"', ' '], '', $target_vids);
        $target_vids = explode(',', $target_vids);
    }
    $target_vids = (array) $target_vids;

    if (empty($target_vids)) {
        return AccessResult::neutral();
    }

    $restricted_vocab_found = false;
    $access_denied = false;
    $denial_message = "";

    $all_node_tids = _sjvn_term_access_get_entity_tids_recursive($node);
    
    $restricted_vocab_found = false;
    $access_denied = false;
    $denial_message = "";

    // Load vocabularies once.
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

    foreach ($target_vids as $vid) {
        $vocab_tids = $term_storage->getQuery()
            ->condition('vid', $vid)
            ->accessCheck(FALSE)
            ->execute();
        
        if (empty($vocab_tids)) continue;

        $user_vid_tids = array_intersect((array)$user_tids, (array)$vocab_tids);

        // If the user has assigned terms in this vocabulary, they are restricted.
        if (!empty($user_vid_tids)) {
            $restricted_vocab_found = true;
            
            // Check if ANY of the node's TIDs (including paragraphs) are in this vocabulary.
            $node_vid_tids = array_intersect((array)$all_node_tids, (array)$vocab_tids);
            
            if (!empty($node_vid_tids)) {
                // Node has terms in this vocab. User MUST match at least one.
                if (!array_intersect((array)$node_vid_tids, (array)$user_vid_tids)) {
                    $access_denied = true;
                    $denial_message = "You are not allowed to $op this content (Restriction: $vid)";
                    break;
                }
            }
            else {
                // Node HAS the potential for this vocab (it's a target vocab), 
                // but no terms are assigned. This is handled by the fallback below.
            }
        }
    }

    if ($access_denied) {
        return AccessResult::forbidden($denial_message)
            ->cachePerUser()
            ->addCacheableDependency($node);
    }

    if (!$restricted_vocab_found) {
        // Fallback: If the user is restricted by ANY target vocabulary, but the node 
        // doesn't have any of those terms assigned yet, we still check if the node's 
        // fields (including Paragraphs) could support such terms.
        $has_potential_restriction = false;
        
        // We can check if any of the collected TIDs belong to ANY target VIDs.
        foreach ($all_node_tids as $tid) {
            $term = $term_storage->load($tid);
            if ($term && in_array($term->bundle(), $target_vids)) {
                $has_potential_restriction = true;
                break;
            }
        }

        if ($has_potential_restriction) {
            return AccessResult::forbidden('You do not have permission to edit this category of content.')
                ->cachePerUser();
        }
    }

    return AccessResult::neutral();
}

/**
 * Implements hook_node_create_access().
 */
function sjvn_term_access_node_create_access(AccountInterface $account, array $context, $entity_bundle) {
    // Admins bypass.
    if ($account->hasPermission('bypass node access') || 
        $account->hasPermission('bypass sjvn category access') || 
        in_array('administrator', $account->getRoles())) {
        return AccessResult::neutral();
    }

    /** @var \Drupal\permissions_by_term\Service\AccessStorage $access_storage */
    $access_storage = \Drupal::service('permissions_by_term.access_storage');
    $user_tids = (array) $access_storage->getPermittedTids($account->id(), $account->getRoles());

    // Also include terms from the user's 'field_contract_unit' profile field.
    $user_entity = \Drupal\user\Entity\User::load($account->id());
    if ($user_entity && $user_entity->hasField('field_contract_unit')) {
        foreach ($user_entity->get('field_contract_unit') as $item) {
            $user_tids[] = $item->target_id;
        }
    }
    $user_tids = array_unique($user_tids);

    $config = \Drupal::config('permissions_by_term.settings');
    $target_vids = $config->get('target_bundles') ?: [];
    if (is_string($target_vids)) {
        $target_vids = str_replace(['[', ']', "'", '"', ' '], '', $target_vids);
        $target_vids = explode(',', $target_vids);
    }
    $target_vids = (array) $target_vids;

    if (empty($target_vids)) {
        return AccessResult::neutral();
    }

    // Check fields on the node bundle.
    $relevant_vids_for_bundle = _sjvn_term_access_get_relevant_vids_recursive('node', $entity_bundle, $target_vids);

    if (empty($relevant_vids_for_bundle)) {
        return AccessResult::neutral();
    }

    foreach ($relevant_vids_for_bundle as $vid) {
        $vocab_tids = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->getQuery()
            ->condition('vid', $vid)
            ->accessCheck(FALSE)
            ->execute();

        if (array_intersect((array)$user_tids, (array)$vocab_tids)) {
            return AccessResult::neutral();
        }
    }

    return AccessResult::forbidden('You do not have permission to create this type of content in any category.')->cachePerUser();
}

/**
 * Implements hook_entity_operation_alter().
 */
function sjvn_term_access_entity_operation_alter(array &$operations, EntityInterface $entity) {
    if (!$entity instanceof NodeInterface) {
        return;
    }

    // Hide all operations (Edit, Delete, Translate, etc.) if the user doesn't have edit access.
    if (!$entity->access('update')) {
        $operations = [];
    }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 */
function sjvn_term_access_form_node_form_alter(&$form, FormStateInterface $form_state, $form_id) {
    $account = \Drupal::currentUser();
    // Admins see everything.
    if ($account->hasPermission('bypass node access') || 
        $account->hasPermission('bypass sjvn category access') || 
        in_array('administrator', $account->getRoles())) {
        return;
    }

    /** @var \Drupal\permissions_by_term\Service\AccessStorage $access_storage */
    $access_storage = \Drupal::service('permissions_by_term.access_storage');
    $user_tids = (array) $access_storage->getPermittedTids($account->id(), $account->getRoles());

    // Also include terms from the user's 'field_contract_unit' profile field.
    $user_entity = \Drupal\user\Entity\User::load($account->id());
    if ($user_entity && $user_entity->hasField('field_contract_unit')) {
        foreach ($user_entity->get('field_contract_unit') as $item) {
            $user_tids[] = $item->target_id;
        }
    }
    $user_tids = array_unique(array_filter($user_tids));

    $config = \Drupal::config('permissions_by_term.settings');
    $target_vids = (array) $config->get('target_bundles') ?: [];
    if (is_string($target_vids)) {
        $target_vids = str_replace(['[', ']', "'", '"', ' '], '', $target_vids);
        $target_vids = explode(',', $target_vids);
    }
    $target_vids = (array) $target_vids;

    $node = $form_state->getFormObject()->getEntity();
    
    // Recursive filtering for all fields (including Paragraphs).
    _sjvn_term_access_filter_form_recursive($form, $user_tids, $target_vids);
}

/**
 * Recursive function to filter taxonomy terms in forms.
 */
function _sjvn_term_access_filter_form_recursive(&$elements, array $user_tids, array $target_vids) {
    foreach (\Drupal\Core\Render\Element::children($elements) as $key) {
        if ($key === 'field_on_behalf_of') {
            continue;
        }

        if (is_array($elements[$key])) {
            // Check for standard options.
            if (isset($elements[$key]['#options']) && is_array($elements[$key]['#options'])) {
                // Determine if this field belongs to one of the target vocabularies.
                $is_target_field = false;
                
                // To be efficient, we only check the first few non-special options.
                $count = 0;
                foreach ($elements[$key]['#options'] as $tid => $label) {
                    if ($tid === '_none' || $tid === '' || !is_numeric($tid)) continue;
                    
                    $term = \Drupal\taxonomy\Entity\Term::load($tid);
                    if ($term && in_array($term->bundle(), $target_vids)) {
                        $is_target_field = true;
                        break;
                    }
                    if (++$count > 3) break; // Check only first 3 to optimize.
                }

                if ($is_target_field) {
                    // Get current value(s) to preserve them even if unauthorized.
                    $current_values = (array) ($elements[$key]['#default_value'] ?? []);
                    
                    foreach ($elements[$key]['#options'] as $tid => $label) {
                        if ($tid === '_none' || $tid === '' || !is_numeric($tid)) continue;
                        
                        // If this TID is currently selected, keep it to avoid defaulting to "None".
                        if (in_array($tid, $current_values)) {
                            continue;
                        }

                        if (!in_array($tid, $user_tids)) {
                            unset($elements[$key]['#options'][$tid]);
                        }
                    }
                }
            }

            // Special handling for SHS (Simple Hierarchical Select).
            if (isset($elements[$key]['#type']) && $elements[$key]['#type'] === 'shs_term_select') {
                // SHS often needs custom handling or it uses the #options of its widget.
                // If it doesn't have options yet, it might be using AJAX.
            }

            // Recurse.
            _sjvn_term_access_filter_form_recursive($elements[$key], $user_tids, $target_vids);
        }
    }
}

/**
 * Gets all taxonomy term IDs from an entity, including nested Paragraphs.
 */
function _sjvn_term_access_get_entity_tids_recursive($entity) {
    if (!$entity || !method_exists($entity, 'getFieldDefinitions')) {
        return [];
    }

    $tids = [];
    foreach ($entity->getFieldDefinitions() as $field_name => $definition) {
        $type = $definition->getType();
        if ($type === 'entity_reference') {
            if ($definition->getSetting('target_type') === 'taxonomy_term') {
                foreach ($entity->get($field_name) as $item) {
                    if ($item->target_id) {
                        $tids[] = $item->target_id;
                    }
                }
            }
        }
        elseif ($type === 'entity_reference_revisions') {
            foreach ($entity->get($field_name) as $item) {
                if ($item->entity) {
                    $tids = array_merge($tids, _sjvn_term_access_get_entity_tids_recursive($item->entity));
                }
            }
        }
    }
    return array_unique($tids);
}

/**
 * Recursively find relevant vocabularies for an entity type and bundle.
 */
function _sjvn_term_access_get_relevant_vids_recursive($entity_type, $bundle, array $target_vids, array &$seen_bundles = []) {
    $cache_key = "$entity_type:$bundle";
    if (isset($seen_bundles[$cache_key])) {
        return [];
    }
    $seen_bundles[$cache_key] = true;

    $relevant_vids = [];
    $fields = \Drupal::service('entity_field.manager')->getFieldDefinitions($entity_type, $bundle);
    
    foreach ($fields as $definition) {
        $type = $definition->getType();
        $settings = $definition->getSettings();

        if ($type === 'entity_reference') {
            if ($settings['target_type'] === 'taxonomy_term' && isset($settings['handler_settings']['target_bundles'])) {
                $f_vids = (array)$settings['handler_settings']['target_bundles'];
                $intersect = array_intersect($f_vids, $target_vids);
                if (!empty($intersect)) {
                    $relevant_vids = array_merge($relevant_vids, $intersect);
                }
            }
        }
        elseif ($type === 'entity_reference_revisions') {
            if ($settings['target_type'] === 'paragraph') {
                // Check all possible paragraph bundles for this field.
                $p_bundles = (array)($settings['handler_settings']['target_bundles'] ?? []);
                foreach ($p_bundles as $p_bundle) {
                    $relevant_vids = array_merge($relevant_vids, _sjvn_term_access_get_relevant_vids_recursive('paragraph', $p_bundle, $target_vids, $seen_bundles));
                }
            }
        }
    }
    
    return array_unique($relevant_vids);
}
