use Drupal\node\Entity\Node;
use Drupal\Core\Entity\Element\EntityAutocomplete;
use Drupal\Core\Entity\EntityInterface;

/**
 * Invalidate DOP view cache when a DOP node is created, updated, or deleted.
 */
function sjvn_custom_entity_insert(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'dop') {
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['view.dop']);
  }
}

function sjvn_custom_entity_update(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'dop') {
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['view.dop']);
  }
}

function sjvn_custom_entity_delete(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'dop') {
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['view.dop']);
  }
}

/**
 * Implements hook_config_schema_info_alter().
 */
function sjvn_custom_config_schema_info_alter(&$definitions) {
  if (isset($definitions['orgchart.charts.*'])) {
    // Mark top-level title as translatable.
    $definitions['orgchart.charts.*']['mapping']['title']['translatable'] = TRUE;
    
    // Mark cell titles and subtitles as translatable for all layouts.
    $layouts = ['desktop', 'tablet', 'phone'];
    foreach ($layouts as $layout) {
      if (isset($definitions['orgchart.charts.*']['mapping']['build']['mapping'][$layout]['mapping']['values']['mapping']['cells']['sequence']['mapping'])) {
        $cell_mapping = &$definitions['orgchart.charts.*']['mapping']['build']['mapping'][$layout]['mapping']['values']['mapping']['cells']['sequence']['mapping'];
        $cell_mapping['title']['translatable'] = TRUE;
        $cell_mapping['subtitle']['translatable'] = TRUE;
      }
    }
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function sjvn_custom_page_attachments_alter(array &$page) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  
  // Apply translation fix for Orgchart routes.
  if (str_starts_with($route_name, 'orgchart.charts.')) {
    $current_lang = \Drupal::languageManager()->getCurrentLanguage()->getId();
    
    // If we are on a non-English page, try to load translations.
    if ($current_lang !== 'en') {
      $config_name = $route_name;
      /** @var \Drupal\language\Config\LanguageConfigOverride $config_override */
      $config_override = \Drupal::languageManager()->getLanguageConfigOverride($current_lang, $config_name);
      
      if (!$config_override->isNew()) {
        $translated_build = $config_override->get('build');
        if (!empty($translated_build) && isset($page['#attached']['drupalSettings']['orgcharts'])) {
          foreach ($translated_build as $layout => $layout_data) {
            if (isset($page['#attached']['drupalSettings']['orgcharts'][$layout])) {
              // Decode the JSON values provided by the Orgchart module.
              $values = json_decode($page['#attached']['drupalSettings']['orgcharts'][$layout]['values'], TRUE);
              
              if (isset($layout_data['values']['cells'])) {
                foreach ($layout_data['values']['cells'] as $index => $cell_data) {
                  // Apply translated Title.
                  if (!empty($cell_data['title']) && isset($values['cells'][$index])) {
                    $values['cells'][$index]['title'] = $cell_data['title'];
                  }
                  // Apply translated Subtitle.
                  if (!empty($cell_data['subtitle']) && isset($values['cells'][$index])) {
                    $values['cells'][$index]['subtitle'] = $cell_data['subtitle'];
                  }
                }
              }
              
              // Re-encode and override the drupalSettings.
              $page['#attached']['drupalSettings']['orgcharts'][$layout]['values'] = json_encode($values);
            }
          }
        }
      }
    }
  }
}

/**
 * Implements hook_menu_local_tasks_alter().
 */
function sjvn_custom_menu_local_tasks_alter(&$data, $route_name, \Drupal\Core\Cache\RefinableCacheableDependencyInterface &$cacheability) {
  // Add Translate tab to Orgchart pages.
  if (str_starts_with($route_name, 'orgchart.configuration.chart.')) {
    $id = \Drupal::routeMatch()->getParameter('id');
    if ($id) {
      $data['tabs'][0]['sjvn_custom.orgchart_translate'] = [
        '#theme' => 'menu_local_task',
        '#link' => [
          'title' => t('Translate'),
          'url' => \Drupal\Core\Url::fromRoute('sjvn_custom.orgchart_translate', ['id' => $id]),
        ],
        '#weight' => 10,
        '#access' => \Drupal::currentUser()->hasPermission('translate configuration'),
      ];
    }
  }
}

/**
 * Node add/edit form alters for Tender Award.
 */
function sjvn_custom_form_node_tender_award_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  _sjvn_custom_tender_award_ajax($form, $form_state);
}

function sjvn_custom_form_node_tender_award_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  _sjvn_custom_tender_award_ajax($form, $form_state);
}

/**
 * Helper to add AJAX and bidirectonal search on Tender Award fields.
 */
function _sjvn_custom_tender_award_ajax(&$form, FormStateInterface $form_state) {
  if (!isset($form['field_tender_title']) || !isset($form['field_is_published_tender'])) {
    return;
  }

  // Wrap relevant fields in a container for AJAX replacement.
  $form['tender_fields_wrapper'] = [
    '#type' => 'container',
    '#attributes' => ['id' => 'tender-award-fields-wrapper'],
    '#weight' => $form['field_is_published_tender']['#weight'] + 1,
  ];

  // Move fields into the wrapper.
  $form['tender_fields_wrapper']['field_is_published_tender'] = $form['field_is_published_tender'];
  unset($form['field_is_published_tender']);

  $form['tender_fields_wrapper']['field_tender_title'] = $form['field_tender_title'];
  unset($form['field_tender_title']);

  $form['tender_fields_wrapper']['field_tender_title_manual'] = $form['field_tender_title_manual'] ?? [];
  unset($form['field_tender_title_manual']);

  $form['tender_fields_wrapper']['field_tender_number'] = $form['field_tender_number'];
  unset($form['field_tender_number']);

  // 1. AJAX for Is Published Tender toggling.
  $form['tender_fields_wrapper']['field_is_published_tender']['widget']['#ajax'] = [
    'callback' => '_sjvn_custom_tender_award_full_ajax_callback',
    'wrapper' => 'tender-award-fields-wrapper',
  ];

  $is_published = $form_state->getValue(['field_is_published_tender', 0, 'value']) ?: 
                  ($form['tender_fields_wrapper']['field_is_published_tender']['widget']['#default_value'][0] ?? 'no');

  // 2. States for visibility.
  $form['tender_fields_wrapper']['field_tender_title']['#states'] = [
    'visible' => [':input[name="field_is_published_tender"]' => ['value' => 'yes']],
  ];
  $form['tender_fields_wrapper']['field_tender_title_manual']['#states'] = [
    'visible' => [':input[name="field_is_published_tender"]' => ['value' => 'no']],
  ];

  // 3. Bidirectional AJAX.
  // A. Title -> Number
  if (isset($form['tender_fields_wrapper']['field_tender_title']['widget'][0]['target_id'])) {
    $form['tender_fields_wrapper']['field_tender_title']['widget'][0]['target_id']['#ajax'] = [
      'callback' => '_sjvn_custom_tender_award_full_ajax_callback',
      'wrapper' => 'tender-award-fields-wrapper',
      'event' => 'change',
    ];
  }

  // B. Number -> Title (Only if Published)
  if ($is_published === 'yes' && isset($form['tender_fields_wrapper']['field_tender_number']['widget'][0]['value'])) {
    $form['tender_fields_wrapper']['field_tender_number']['widget'][0]['value']['#ajax'] = [
      'callback' => '_sjvn_custom_tender_award_full_ajax_callback',
      'wrapper' => 'tender-award-fields-wrapper',
      'event' => 'change',
    ];
  }

  // Determine values based on user input or existing data.
  $user_input = $form_state->getUserInput();
  $triggering_element = $form_state->getTriggeringElement();
  $trig_name = $triggering_element ? end($triggering_element['#parents']) : '';
  
  // Logic: If 'Is Published' was changed to 'No', clear the auto-fetched fields.
  if ($trig_name === 'field_is_published_tender' && $is_published === 'no') {
    $form['tender_fields_wrapper']['field_tender_number']['widget'][0]['value']['#value'] = '';
    $form_state->setValue('field_tender_number', []);
    $form_state->setValue('field_tender_title', []);
    return;
  }

  // Try to get the ID from various sources.
  $title_input = $user_input['field_tender_title'][0]['target_id'] 
    ?? $form_state->getValue(['field_tender_title', 0, 'target_id']);
  
  $tender_nid = NULL;
  if (is_numeric($title_input)) {
    $tender_nid = (int) $title_input;
  }
  elseif (is_string($title_input) && !empty($title_input)) {
    $tender_nid = EntityAutocomplete::extractEntityIdFromAutocompleteInput($title_input);
    if (!$tender_nid) {
      $clean_title = trim($title_input, " \t\n\r\0\x0B\"'");
      $title_query = \Drupal::entityQuery('node')
        ->condition('type', 'tender')
        ->condition('title', $clean_title)
        ->accessCheck(FALSE)
        ->range(0, 1);
      $title_nids = $title_query->execute();
      if ($title_nids) {
        $tender_nid = reset($title_nids);
      }
    }
  }

  // Logic: If Number was changed, try to find matching Title.
  if ($trig_name === 'value' && in_array('field_tender_number', $triggering_element['#parents'])) {
    $tender_number = $form_state->getValue(['field_tender_number', 0, 'value']);
    if (!empty($tender_number)) {
      $query = \Drupal::entityQuery('node')
        ->condition('type', 'tender')
        ->condition('field_tender_number', $tender_number)
        ->accessCheck(FALSE)
        ->range(0, 1);
      if ($nids = $query->execute()) {
        $found_nid = reset($nids);
        if ($node = Node::load($found_nid)) {
          // Clean display: No ID in brackets.
          $form['tender_fields_wrapper']['field_tender_title']['widget'][0]['target_id']['#value'] = $node->label();
          $form_state->setValue('field_tender_title', [['target_id' => $found_nid]]);
        }
      }
    }
  }
  // Logic: If Title was changed, fetch Number.
  elseif ($tender_nid) {
    if ($tender_node = Node::load($tender_nid)) {
      if ($tender_node->hasField('field_tender_number')) {
        $fetched_number = $tender_node->get('field_tender_number')->value;
        $form['tender_fields_wrapper']['field_tender_number']['widget'][0]['value']['#value'] = $fetched_number;
        $form_state->setValue('field_tender_number', [['value' => $fetched_number]]);
      }
      // Attempt to strip the (NID) for cleaner UI during the AJAX callback.
      $form['tender_fields_wrapper']['field_tender_title']['widget'][0]['target_id']['#value'] = $tender_node->label();
    }
  }
}

/**
 * AJAX callback to return the entire tender fields wrapper.
 */
function _sjvn_custom_tender_award_full_ajax_callback(array &$form, FormStateInterface $form_state) {
  return $form['tender_fields_wrapper'];
}

