/**
 * Implements hook_csv_importer_pre_import().
 * 
 * Maps term names to term IDs for 'field_mode_of_tendering' during CSV upload.
 */
function sjvn_custom_csv_importer_pre_import(&$data) {
  if (empty($data['content'])) {
    return;
  }

  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  foreach ($data['content'] as &$row) {
    // Fix for long titles: Drupal node title column has a max length of 255 chars.
    // Explicitly use UTF-8 to avoid mangling multi-byte (Hindi) characters.
    if (!empty($row['title'])) {
      // Decode HTML entities (e.g., &gt; -> >) which sometimes appear in CSV exports.
      $row['title'] = html_entity_decode($row['title'], ENT_QUOTES | ENT_HTML5, 'UTF-8');
      
      if (mb_strlen($row['title'], 'UTF-8') > 255) {
        $row['title'] = mb_substr($row['title'], 0, 252, 'UTF-8') . '...';
      }
    }

    if (!empty($row['field_mode_of_tendering']) && is_string($row['field_mode_of_tendering'])) {
      $term_name = trim($row['field_mode_of_tendering']);
      
      // Attempt to load the term by name in the 'mode_of_tendering' vocabulary.
      $terms = $term_storage->loadByProperties([
        'name' => $term_name,
        'vid' => 'mode_of_tendering',
      ]);

      if ($terms) {
        $term = reset($terms);
        $row['field_mode_of_tendering'] = $term->id();
      }
      else {
        // Optional: If term is not found, we could log a warning.
        \Drupal::logger('sjvn_custom')->warning('Term not found during CSV import for Mode Of Tendering: @name', ['@name' => $term_name]);
      }
    }
  }
}

/**
 * Implements hook_views_post_execute().
 *
 * For the 'our_project' view, the SQL query must join through English paragraphs
 * (paragraph translations often don't exist), so it returns English field values.
 * After the query executes, we swap the field values with the current language
 * translation so that tokens like {{ title }} render in Hindi.
 */
function sjvn_custom_views_post_execute(\Drupal\views\ViewExecutable $view) {
  if ($view->id() !== 'our_project') {
    return;
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();

  $entity_storage = \Drupal::entityTypeManager()->getStorage('node');
  
  // Keep track of seen NIDs to eliminate duplicates.
  $seen_nids = [];
  $unique_results = [];

  foreach ($view->result as $key => $row) {
    if (empty($row->nid)) {
      $unique_results[] = $row;
      continue;
    }

    // Skip if we've already seen this node.
    if (in_array($row->nid, $seen_nids)) {
      continue;
    }
    
    $seen_nids[] = $row->nid;
    
    // If we're not using English, attempt translation swap.
    if ($langcode !== 'en') {
      $node = $entity_storage->load($row->nid);
      
      if ($node && $node->hasTranslation($langcode)) {
        $translated = $node->getTranslation($langcode);

        // Swap the entity reference so entity-level rendering uses translation.
        $row->_entity = $translated;

        // Swap SQL result values that are used by field tokens.
        if (isset($row->node_field_data_title)) {
          $row->node_field_data_title = $translated->getTitle();
        }

        if (property_exists($row, 'node_field_data_langcode')) {
          $row->node_field_data_langcode = $langcode;
        }
      }
    }
    
    // Add the unique row to our new results array.
    $unique_results[] = $row;
  }
  
  // Replace the view's results with the deduplicated array.
  $view->result = $unique_results;
  // Also update total rows if it was calculated.
  $view->total_rows = count($unique_results);
}

/**
 * Implements hook_preprocess_field().
 */
function sjvn_custom_preprocess_field(&$variables) {
  $element = $variables['element'];
  // For 'career' content type, reverse the order of 'field_upload_files' items 
  // so that the most recent uploads (highest deltas) are displayed first.
  if (isset($element['#field_name']) && $element['#field_name'] == 'field_upload_files' && 
      isset($element['#bundle']) && $element['#bundle'] == 'career') {
    if (!empty($variables['items'])) {
      $variables['items'] = array_reverse($variables['items']);
    }
  }
}


/**
 * Implements hook_node_access().
 * 
 * Ensures the frontend remains public on logout even when 
 * category-wise editorial permissions are used.
 */
function sjvn_custom_node_access(\Drupal\node\NodeInterface $node, $op, \Drupal\Core\Session\AccountInterface $account) {
  // Administrators bypass all restrictions and are explicitly allowed.
  if ($account->hasPermission('bypass node access') || in_array('administrator', $account->getRoles())) {
    return \Drupal\Core\Access\AccessResult::allowed()->cachePerPermissions();
  }

  // Allow all users (including logged-in) to view published content on the frontend,
  // bypassing category-wise (PbT) view restrictions.
  if ($op === 'view' && $node->isPublished()) {
    return \Drupal\Core\Access\AccessResult::allowed()->addCacheableDependency($node);
  }

  // Allow content editors and environment role to view unpublished content.
  if ($op === 'view' && !$node->isPublished()) {
    $roles = $account->getRoles();
    if (in_array('content_editor', $roles) || in_array('environment', $roles)) {
      return \Drupal\Core\Access\AccessResult::allowed()->cachePerPermissions()->addCacheableDependency($node);
    }
  }
  return \Drupal\Core\Access\AccessResult::neutral();
}

/**
 * Implements hook_taxonomy_term_access().
 *
 * Ensures that taxonomy terms remain publicly viewable so that Views 
 * using term contextual filters (like subsidiary/%) do not return 404.
 */
function sjvn_custom_taxonomy_term_access(\Drupal\taxonomy\TermInterface $term, $op, \Drupal\Core\Session\AccountInterface $account) {
  if ($op === 'view') {
    return \Drupal\Core\Access\AccessResult::allowed();
  }
  return \Drupal\Core\Access\AccessResult::neutral();
}

/**
 * Implements hook_views_query_alter().
 */
function sjvn_custom_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\Sql $query) {
  // Bypasses node access SQL rewrite for all users so that public
  // content (which may be restricted by category-wise permissions for editors)
  // remains visible in all site-wide listings (Views).
  $query->options['disable_sql_rewrite'] = TRUE;
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for taxonomy_term_form.
 */
function sjvn_custom_form_taxonomy_term_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Lock the 'administrator' role checkbox in Permissions by Term settings.
  if (isset($form['access']['role'])) {
    $form['#after_build'][] = '_sjvn_custom_term_form_after_build';
    // Add validation handler to ensure the administrator role stays enabled
    // because disabled checkboxes are not submitted in POST.
    array_unshift($form['#validate'], '_sjvn_custom_term_form_validate');
  }
}

/**
 * Custom #after_build callback for taxonomy term forms to lock Administrator role.
 */
function _sjvn_custom_term_form_after_build($form, FormStateInterface $form_state) {
  if (isset($form['access']['role']['administrator'])) {
    $form['access']['role']['administrator']['#attributes']['checked'] = 'checked';
    $form['access']['role']['administrator']['#attributes']['disabled'] = 'disabled';
  }
  return $form;
}

/**
 * Custom validation handler to make sure 'administrator' role is saved even if disabled.
 */
function _sjvn_custom_term_form_validate(&$form, FormStateInterface $form_state) {
  $access = $form_state->getValue('access');
  if (isset($access['role']) && is_array($access['role'])) {
    $access['role']['administrator'] = 'administrator';
    $form_state->setValue('access', $access);
  }
}