/**
 * Node add/edit form alters for Tender.
 */
function sjvn_custom_form_node_tender_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  _sjvn_custom_tender_states($form);
  _sjvn_custom_tender_handle_cu($form, $form_state);
}

function sjvn_custom_form_node_tender_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  _sjvn_custom_tender_states($form);
  _sjvn_custom_tender_handle_cu($form, $form_state);
}

/**
 * Handle Contract Unit fields: Pre-populate, Filter, and Re-populate options.
 */
function _sjvn_custom_tender_handle_cu(&$form, FormStateInterface $form_state) {
  // 1. Force FULL list for 'On behalf of' (bypass PbT).
  if (isset($form['field_on_behalf_of']['widget']['#options'])) {
    $vids = ['contract_unit'];
    $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['vid' => $vids]);
    uasort($terms, function($a, $b) {
      return strcasecmp($a->getName(), $b->getName());
    });
    
    $full_options = ['_none' => t('- None -')];
    foreach ($terms as $term) {
      $full_options[$term->id()] = $term->label();
    }
    $form['field_on_behalf_of']['widget']['#options'] = $full_options;
  }

  // 2. Use #after_build for 'Contract Unit' to ensure it's restricted to 1 option.
  if (isset($form['field_contract_unit'])) {
    $form['field_contract_unit']['#after_build'][] = '_sjvn_custom_tender_cu_after_build';
  }
}

/**
 * After build callback to lock Contract Unit to exactly 1 option.
 */
function _sjvn_custom_tender_cu_after_build($element, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!method_exists($form_object, 'getEntity')) {
    return $element;
  }
  
  $node = $form_object->getEntity();
  $author = $node->getOwner();
  if (!$author || $author->isAnonymous()) {
    $author = \Drupal\user\Entity\User::load(\Drupal::currentUser()->id());
  }

  $target_tid = NULL;
  
  // Priority 1: Already saved value.
  if (!$node->isNew()) {
    $target_tid = $node->get('field_contract_unit')->target_id;
  }
  
  // Priority 2: Author's primary unit.
  if (!$target_tid && $author && $author->hasField('field_contract_unit') && !$author->get('field_contract_unit')->isEmpty()) {
    $target_tid = $author->get('field_contract_unit')->first()->target_id;
  }

  if ($target_tid) {
    $term = \Drupal\taxonomy\Entity\Term::load($target_tid);
    if ($term) {
      // For select widgets, options are in the first child.
      $element['widget']['#options'] = [
        $target_tid => $term->label(),
      ];
      // Also ensure default value is set.
      $element['widget']['#default_value'] = [$target_tid];
    }
  }
  else {
    // Fallback: If no unit found, don't clear everything if it's already there, 
    // but the requirement is "create kiya hai uska aaye". 
    // If still empty, we might want to show a message or keep default.
  }

  return $element;
}

/**
 * Helper to add states to tender form.
 */
function _sjvn_custom_tender_states(&$form) {
  // Fields from the image:
  // 1. field_show_beyond_date (Radios: No/Yes)
  // 2. field_beyond_date (Date field)

  if (isset($form['field_beyond_date']) && isset($form['field_show_beyond_date'])) {
    // Forcefully remove the "N/A" option (usually keyed as '_none') from radios.
    if (isset($form['field_show_beyond_date']['widget']['#options']['_none'])) {
      unset($form['field_show_beyond_date']['widget']['#options']['_none']);
    }
    
    // Ensure the field is required to prevent empty submission after removing N/A.
    $form['field_show_beyond_date']['widget']['#required'] = TRUE;

    // Show and make the date required only when 'On' (1) is selected.
    $form['field_beyond_date']['#states'] = [
      'visible' => [
        ':input[name="field_show_beyond_date"]' => ['value' => '1'],
      ],
      'required' => [
        ':input[name="field_show_beyond_date"]' => ['value' => '1'],
      ],
    ];
  }
}

/**
 * Add toggle to nested paragraph fields with robust widget checks.
 */
function _sjvn_custom_add_toggle(&$form) {

  if (!isset($form['field_group_content']['widget'])) {
    return;
  }

  foreach ($form['field_group_content']['widget'] as $delta => &$item) {

    if (!is_int($delta) || !isset($item['subform']['field_add_content']['widget'])) {
      continue;
    }

    foreach ($item['subform']['field_add_content']['widget'] as $child_delta => &$child_item) {

      if (!is_int($child_delta) || !isset($child_item['subform'])) {
        continue;
      }

      // Default is description for new paragraphs.
      $default = 'description';

      // === Robust detection from widget values ===
      $link_has_value = _sjvn_widget_has_link_value($child_item);
      $file_has_value = _sjvn_widget_has_file_value($child_item);
      $desc_has_value = _sjvn_widget_has_description_value($child_item);

      // Priority: link -> file -> description
      if ($link_has_value) {
        $default = 'link';
      } elseif ($file_has_value) {
        $default = 'file';
      } elseif ($desc_has_value) {
        $default = 'description';
      } else {
        // If this is an edit form, sometimes the form-level '#default_value' exists
        // at the field level (not widget). Check and prefer link/file there too.
        if (!empty($child_item['subform']['field_link']['#default_value'])) {
          $default = 'link';
        } elseif (!empty($child_item['subform']['field_upload_files']['#default_value'])) {
          $default = 'file';
        } elseif (!empty($child_item['subform']['field_descriptions']['#default_value'])) {
          $default = 'description';
        }
      }

      // Add dropdown
      $child_item['subform']['group_toggle'] = [
        '#type' => 'select',
        '#title' => t('Select Field to Show'),
        '#options' => [
          'description' => t('Description'),
          'link' => t('Link'),
          'file' => t('File'),
        ],
        '#default_value' => $default,
      ];

      // States
      if (isset($child_item['subform']['field_descriptions'])) {
        $child_item['subform']['field_descriptions']['#states'] = [
          'visible' => [
            ':input[name="field_group_content['.$delta.'][subform][field_add_content]['.$child_delta.'][subform][group_toggle]"]' => ['value' => 'description'],
          ],
        ];
      }
      if (isset($child_item['subform']['field_link'])) {
        $child_item['subform']['field_link']['#states'] = [
          'visible' => [
            ':input[name="field_group_content['.$delta.'][subform][field_add_content]['.$child_delta.'][subform][group_toggle]"]' => ['value' => 'link'],
          ],
        ];
      }
      if (isset($child_item['subform']['field_upload_files'])) {
        $child_item['subform']['field_upload_files']['#states'] = [
          'visible' => [
            ':input[name="field_group_content['.$delta.'][subform][field_add_content]['.$child_delta.'][subform][group_toggle]"]' => ['value' => 'file'],
          ],
        ];
      }
    }
  }
}

/**
 * Returns TRUE when description widget has meaningful text.
 */
function _sjvn_widget_has_description_value(array $child_item) : bool {
  if (empty($child_item['subform']['field_descriptions']['widget']) || !is_array($child_item['subform']['field_descriptions']['widget'])) {
    return FALSE;
  }

  // Usually the first delta holds the value.
  $widget = $child_item['subform']['field_descriptions']['widget'][0] ?? NULL;
  if (!is_array($widget)) {
    return FALSE;
  }

  // Try multiple paths for the value.
  $value = NULL;
  if (isset($widget['value']['#default_value'])) {
    $value = $widget['value']['#default_value'];
  } elseif (isset($widget['value']['#value'])) {
    $value = $widget['value']['#value'];
  } elseif (isset($child_item['subform']['field_descriptions']['#default_value'])) {
    $value = $child_item['subform']['field_descriptions']['#default_value'];
  }

  if (!is_string($value) && !is_numeric($value)) {
    return FALSE;
  }

  return trim((string) $value) !== '';
}

/**
 * Returns TRUE when link widget has an URI.
 */
function _sjvn_widget_has_link_value(array $child_item) : bool {
  if (empty($child_item['subform']['field_link'])) {
    return FALSE;
  }

  // Check widget structure first.
  $widget = $child_item['subform']['field_link']['widget'][0] ?? NULL;
  if (is_array($widget)) {
    // Common places where URI can appear.
    if (!empty($widget['uri']['#default_value'])) {
      return trim((string) $widget['uri']['#default_value']) !== '';
    }
    if (!empty($widget['uri']['#value'])) {
      return trim((string) $widget['uri']['#value']) !== '';
    }
    // Some link widgets store '#default_value' at field level.
    if (!empty($child_item['subform']['field_link']['#default_value'])) {
      // Here #default_value could be an array/object, attempt to read uri.
      $dv = $child_item['subform']['field_link']['#default_value'];
      if (is_array($dv) && !empty($dv[0]['uri'])) {
        return trim((string) $dv[0]['uri']) !== '';
      }
      if (is_string($dv) && trim($dv) !== '') {
        return TRUE;
      }
    }
  }

  return FALSE;
}

/**
 * Returns TRUE when file widget has a real uploaded file.
 *
 * We check multiple indicators:
 * - widget[0]['target_id']['#default_value']
 * - widget[0]['#default_value'] (may contain file IDs)
 * - presence of 'remove_button' or '#file' in widget (means file exists)
 */
function _sjvn_widget_has_file_value(array $child_item) : bool {
  if (empty($child_item['subform']['field_upload_files'])) {
    return FALSE;
  }

  $widget = $child_item['subform']['field_upload_files']['widget'][0] ?? NULL;
  if (!is_array($widget) && empty($child_item['subform']['field_upload_files']['#default_value'])) {
    return FALSE;
  }

  // Check explicit target_id default.
  if (is_array($widget) && !empty($widget['target_id']['#default_value'])) {
    // target_id may be scalar or array.
    if (is_array($widget['target_id']['#default_value'])) {
      return count(array_filter($widget['target_id']['#default_value'])) > 0;
    }
    return (string) $widget['target_id']['#default_value'] !== '';
  }

  // Check common '#default_value' (file id list).
  if (!empty($widget['#default_value'])) {
    if (is_array($widget['#default_value'])) {
      // array of fids or file arrays.
      foreach ($widget['#default_value'] as $v) {
        if (is_numeric($v) || (!empty($v))) {
          return TRUE;
        }
      }
    } elseif ((string) $widget['#default_value'] !== '') {
      return TRUE;
    }
  }

  // Check field-level #default_value
  if (!empty($child_item['subform']['field_upload_files']['#default_value'])) {
    return TRUE;
  }

  // Check file display indicators (remove_button, #file) that show uploaded file.
  if (is_array($widget)) {
    if (!empty($widget['remove_button']) || !empty($widget['#file']) || !empty($widget['display'])) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 */
function sjvn_custom_form_node_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Drupal core restricts the 'status' (Published) field and its group to users 
  // with the 'administer nodes' permission. We explicitly grant access here.
  if (isset($form['status'])) {
    $form['status']['#access'] = TRUE;
    
    // Core often places 'status' inside an 'options' group which is hidden.
    if (isset($form['options'])) {
      $form['options']['#access'] = TRUE;
    }
  }
}

/**
 * Implements hook_entity_field_access().
 */
function sjvn_custom_entity_field_access($operation, \Drupal\Core\Field\FieldDefinitionInterface $field_definition, \Drupal\Core\Session\AccountInterface $account, \Drupal\Core\Field\FieldItemListInterface $items = NULL) {
  // Broadly grant edit access to the 'status' field for nodes if the user can edit the node.
  if ($operation === 'edit' && $field_definition->getName() === 'status') {
    if ($field_definition->getTargetEntityTypeId() === 'node') {
      return \Drupal\Core\Access\AccessResult::allowed()->cachePerPermissions();
    }
  }

  // Restrict view access to field_loa (LOA Document) in tender_award content type.
  if ($operation === 'view' && $field_definition->getName() === 'field_loa') {
    if ($field_definition->getTargetEntityTypeId() === 'node') {
      // Staff (admins/editors) should see this.
      // Also allow users with the specific 'loa' role if they are the "LOA user".
      if ($account->hasPermission('bypass node access') || 
          in_array('administrator', $account->getRoles()) || 
          in_array('content_editor', $account->getRoles())) {
        return \Drupal\Core\Access\AccessResult::neutral();
      }

      if ($items) {
        $node = $items->getEntity();
        if ($node instanceof \Drupal\node\NodeInterface && $node->getType() === 'tender_award') {
          // 1. Check if user is in the 'vender_list' of the parent Tender.
          if ($node->hasField('field_tender_title') && !$node->get('field_tender_title')->isEmpty()) {
            $tender = $node->get('field_tender_title')->entity;
            if ($tender && $tender->hasField('field_vender_list')) {
              foreach ($tender->get('field_vender_list') as $item) {
                if ($item->target_id == $account->id()) {
                  return \Drupal\Core\Access\AccessResult::allowed()
                    ->addCacheableDependency($node)
                    ->addCacheableDependency($tender)
                    ->cachePerUser();
                }
              }
            }
          }

          // 2. Fallback: If user has 'loa' role, maybe they should see it?
          // (Keeping this secondary if it's meant to be role-based).
          if (in_array('loa', $account->getRoles())) {
             return \Drupal\Core\Access\AccessResult::allowed()->cachePerUser();
          }

          // If not authorized staff or the assigned vendor, forbid field access.
          return \Drupal\Core\Access\AccessResult::forbidden()->addCacheableDependency($node);
        }
      }
    }
  }

  return \Drupal\Core\Access\AccessResult::neutral();
}

/**
 * Implements hook_node_access().
 */
function sjvn_custom_node_access(\Drupal\node\NodeInterface $node, $op, \Drupal\Core\Session\AccountInterface $account) {
  // Allow content editors to view unpublished content.
  if ($op === 'view' && !$node->isPublished()) {
    if (in_array('content_editor', $account->getRoles())) {
      return \Drupal\Core\Access\AccessResult::allowed()->cachePerPermissions()->addCacheableDependency($node);
    }
  }
  return \Drupal\Core\Access\AccessResult::neutral();
}
